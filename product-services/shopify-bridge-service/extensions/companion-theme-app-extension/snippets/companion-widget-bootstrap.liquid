<div
  class="loom-companion-embed-root"
  data-loom-companion-bootstrap="true"
  data-mount-role="{{ mount_role | default: 'app-embed' | escape }}"
  data-surface-mount="{{ surface_mount | default: 'floating' | escape }}"
  data-surface-scope="{{ surface_scope | default: 'all' | escape }}"
  data-shell-enabled="{{ shell_enabled | default: 'true' | escape }}"
  data-bridge-base-url="{{ bridge_base_url | escape }}"
  data-launcher-label="{{ launcher_label | default: 'Ask the store assistant' | escape }}"
  data-widget-shell="max-mode"
  data-max-mode-shell-script-url="{{ 'companion-max-mode-shell.js' | asset_url | escape }}"
  data-max-mode-script-url="{{ 'max-mode-widget.iife.js' | asset_url | escape }}"
  data-embedded-surfaces-script-url="{{ 'companion-embedded-surfaces.js' | asset_url | escape }}"
  data-embedded-surfaces-stylesheet-url="{{ 'companion-embedded-surfaces.css' | asset_url | escape }}"
  data-shop-domain="{{ shop.permanent_domain | escape }}"
  data-page-type="{{ request.page_type | default: 'unknown' | escape }}"
  data-page-title="{{ page_title | escape }}"
  data-product-id="{% if product %}{{ product.id }}{% endif %}"
  data-product-handle="{% if product %}{{ product.handle | escape }}{% endif %}"
  data-product-title="{% if product %}{{ product.title | escape }}{% endif %}"
  data-product-vendor="{% if product %}{{ product.vendor | escape }}{% endif %}"
  data-product-type="{% if product %}{{ product.type | escape }}{% endif %}"
  data-product-variant-id="{% if product and product.selected_or_first_available_variant %}{{ product.selected_or_first_available_variant.id }}{% endif %}"
  data-product-sku="{% if product and product.selected_or_first_available_variant %}{{ product.selected_or_first_available_variant.sku | escape }}{% endif %}"
  data-product-price-cents="{% if product and product.selected_or_first_available_variant %}{{ product.selected_or_first_available_variant.price }}{% endif %}"
  data-collection-id="{% if collection %}{{ collection.id }}{% endif %}"
  data-collection-handle="{% if collection %}{{ collection.handle | escape }}{% endif %}"
  data-collection-title="{% if collection %}{{ collection.title | escape }}{% endif %}"
  data-document-id="{% if article %}{{ article.id }}{% elsif page %}{{ page.id }}{% elsif blog %}{{ blog.id }}{% endif %}"
  data-document-handle="{% if article %}{{ article.handle | escape }}{% elsif page %}{{ page.handle | escape }}{% elsif blog %}{{ blog.handle | escape }}{% endif %}"
  data-document-title="{% if article %}{{ article.title | escape }}{% elsif page %}{{ page.title | escape }}{% elsif blog %}{{ blog.title | escape }}{% endif %}"
  data-document-type="{% if article %}article{% elsif page %}page{% elsif blog %}blog{% endif %}"
  data-document-url="{% if article %}{{ article.url | escape }}{% elsif page %}{{ page.url | escape }}{% elsif blog %}{{ blog.url | escape }}{% endif %}"
></div>
