<div
  id="loom-companion-embed-root"
  class="loom-companion-embed-root"
  data-bridge-base-url="{{ bridge_base_url | escape }}"
  data-launcher-label="{{ launcher_label | default: 'Ask the store assistant' | escape }}"
  data-widget-shell="{{ widget_shell | default: 'legacy' | escape }}"
  data-legacy-shell-script-url="{{ 'companion-legacy-shell.js' | asset_url | escape }}"
  data-max-mode-shell-script-url="{{ 'companion-max-mode-shell.js' | asset_url | escape }}"
  data-max-mode-script-url="{{ 'max-mode-widget.iife.js' | asset_url | escape }}"
  data-shop-domain="{{ shop.permanent_domain | escape }}"
  data-page-type="{{ request.page_type | default: 'unknown' | escape }}"
  data-page-title="{{ page_title | escape }}"
  data-product-id="{% if product %}{{ product.id }}{% endif %}"
  data-product-handle="{% if product %}{{ product.handle | escape }}{% endif %}"
  data-product-title="{% if product %}{{ product.title | escape }}{% endif %}"
  data-product-vendor="{% if product %}{{ product.vendor | escape }}{% endif %}"
  data-product-type="{% if product %}{{ product.type | escape }}{% endif %}"
  data-product-price-cents="{% if product and product.selected_or_first_available_variant %}{{ product.selected_or_first_available_variant.price }}{% endif %}"
  data-collection-id="{% if collection %}{{ collection.id }}{% endif %}"
  data-collection-handle="{% if collection %}{{ collection.handle | escape }}{% endif %}"
  data-collection-title="{% if collection %}{{ collection.title | escape }}{% endif %}"
></div>
