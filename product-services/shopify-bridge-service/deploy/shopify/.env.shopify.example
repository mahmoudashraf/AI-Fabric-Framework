# Copy this file to deploy/shopify/.env.shopify and fill in the real values.
# Both render-shopify-app-config.sh and shopify-cli-preflight.sh load that file automatically.

# Required for generating product-services/shopify-bridge-service/shopify.app.toml

SHOPIFY_CLI_APP_CLIENT_ID=replace-with-real-shopify-app-client-id
SHOPIFY_CLI_APP_NAME="Loom Companion"
SHOPIFY_CLI_APP_HANDLE=loom-companion
SHOPIFY_CLI_APP_EMBEDDED=true
SHOPIFY_CLI_APP_SCOPES=read_products,read_content
SHOPIFY_CLI_APP_API_VERSION=2026-04
SHOPIFY_CLI_APP_PROXY_SUBPATH=loom-companion

# Public URL of the merchant embedded app.
# If the merchant UI is served by the same host as the bridge backend, set this to the same value
# as SHOPIFY_BRIDGE_PUBLIC_BASE_URL.
SHOPIFY_APP_PUBLIC_BASE_URL=https://replace-with-shopify-app.example.com

# Public URL of the deployed Shopify Bridge backend.
SHOPIFY_BRIDGE_PUBLIC_BASE_URL=https://replace-with-shopify-bridge.example.com

# Optional overrides
# SHOPIFY_CLI_DEV_STORE_URL=https://shopping-companion-test.myshopify.com
# SHOPIFY_CLI_APP_CALLBACK_URL=https://replace-with-shopify-bridge.example.com/auth/shopify/callback
# SHOPIFY_APP_TOML_OUTPUT=/absolute/path/to/shopify.app.toml
# SHOPIFY_MIN_FREE_MB=2048
# SHOPIFY_SKIP_CLI_CHECK=true
# SHOPIFY_SKIP_SPACE_CHECK=true
