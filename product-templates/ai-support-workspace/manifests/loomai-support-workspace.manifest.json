{
  "schemaVersion": 1,
  "pluginId": "mkp-template-loomai-support-workspace",
  "version": "1.0.0",
  "pluginType": "TEMPLATE",
  "displayName": "LoomAI Internal Support Workspace",
  "description": "Internal LoomAI customer support using isolated approved object-storage guides and explicitly authorized case-scoped diagnostic reads. Not a public customer default.",
  "compatibility": {"requiredCapabilities": ["templates"], "supportedDeploymentTargets": ["custom-start-from-scratch"], "supportedAuthModes": ["PRIVATE_RUNTIME_BACKEND_MEDIATED", "PUBLIC_RUNTIME_AUTHENTICATED"]},
  "pricing": {"pricingModel": "FREE"},
  "permissions": {"contributesTemplate": true, "contributesShellPresentation": true},
  "contributions": {
    "template": {
      "templateId": "custom-start-from-scratch",
      "curatedModuleId": "default",
      "requiredPluginRefs": ["mkp-data-ai-support-documents@1.0.0", "mkp-action-loomai-support-diagnostics@1.0.3"],
      "requiredPluginInstallDefaults": {
        "mkp-action-loomai-support-diagnostics@1.0.3": {"config": {}, "secretRefs": {}}
      },
      "recommendedPluginIds": ["mkp-integration-loomai-desk"],
      "deploymentBehavior": {
        "type": "CONVERSATIONAL",
        "contractVersion": 1,
        "verificationPackIds": ["conversational-behavior-v1"],
        "allowedChannelBindings": ["BACKEND_API", "DOCKED_COMPOSER", "MAX_MODE", "INLINE_ASSISTANT", "QUERY_ONCE"],
        "allowedExecutionExtensions": ["SPECIALIST_ASSISTANCE", "CONVERSATION_HANDOVER"],
        "defaultExecutionExtensions": []
      },
      "shell": {
        "greeting": {"title": "LoomAI Support", "message": "Ask about LoomAI setup and approved support guidance. Current resource checks require your explicit diagnostic consent; human support depends on the connected team."},
        "enabledModuleIds": ["support", "docs"],
        "defaultConversationMode": "executor"
      }
    }
  }
}
