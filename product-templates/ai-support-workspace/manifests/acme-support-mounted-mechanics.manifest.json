{
  "schemaVersion": 1,
  "pluginId": "mkp-template-acme-support-mounted-mechanics",
  "version": "1.0.0",
  "pluginType": "TEMPLATE",
  "displayName": "Acme Support - Non-production Mounted Mechanics",
  "description": "Fictional isolated staging mechanics only: operator-mounted Acme guides and an external simulated support API. Not customer S3/storage qualification or a production Acme service.",
  "compatibility": {"requiredCapabilities": ["templates"], "supportedDeploymentTargets": ["custom-start-from-scratch"], "supportedAuthModes": ["PRIVATE_RUNTIME_BACKEND_MEDIATED", "PUBLIC_RUNTIME_AUTHENTICATED"]},
  "pricing": {"pricingModel": "FREE"},
  "permissions": {"contributesTemplate": true, "contributesShellPresentation": true},
  "contributions": {
    "template": {
      "templateId": "custom-start-from-scratch",
      "curatedModuleId": "default",
      "requiredPluginRefs": ["mkp-data-document-knowledge-mounted-demo@1.0.0", "mkp-action-acme-cloud-support-reads@1.0.1"],
      "requiredPluginInstallDefaults": {
        "mkp-action-acme-cloud-support-reads@1.0.1": {"config": {}, "secretRefs": {}}
      },
      "recommendedPluginIds": ["mkp-integration-loomai-desk"],
      "deploymentBehavior": {
        "type": "CONVERSATIONAL",
        "contractVersion": 1,
        "verificationPackIds": ["conversational-behavior-v1"],
        "allowedChannelBindings": ["BACKEND_API", "DOCKED_COMPOSER", "MAX_MODE", "INLINE_ASSISTANT", "QUERY_ONCE"],
        "allowedExecutionExtensions": ["SPECIALIST_ASSISTANCE", "CONVERSATION_HANDOVER"],
        "defaultExecutionExtensions": []
      },
      "shell": {
        "greeting": {"title": "Acme support staging mechanics", "message": "A fictional non-production support example. Approved mounted guides and simulated account checks require their configured integrations."},
        "enabledModuleIds": ["support", "docs"],
        "defaultConversationMode": "executor"
      }
    }
  }
}
