{
  "name": "@loom-ai-labs/support-experience-pack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/support-experience.esm.js",
  "module": "./dist/support-experience.esm.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/support-experience.esm.js" }, "./embed": "./dist/support-experience.iife.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build --config vite.config.iife.ts && tsc -p tsconfig.build.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "npm run build && node --test tests/core.test.mjs",
    "test:browser": "npm run build && node --test tests/browser.test.mjs tests/installer.test.mjs",
    "preview": "node scripts/preview-server.mjs"
  },
  "devDependencies": { "typescript": "5.8.3", "vite": "6.4.5", "@types/node": "25.5.2" }
}
