{
  "schemaVersion": 1,
  "pluginId": "mkp-data-neutral-vehicle-profile-a-verification",
  "version": "1.0.1",
  "pluginType": "DATA",
  "displayName": "Internal Verification Vehicle Source - Profile A",
  "description": "Internal-only form-token, page-pagination vehicle source for hosted generic integration verification.",
  "compatibility": {
    "requiredCapabilities": ["knowledgeSources"],
    "supportedDeploymentTargets": ["custom-start-from-scratch"]
  },
  "pricing": {"pricingModel": "FREE"},
  "installForm": [
    {"id": "providerKey", "label": "Provider key", "type": "secretref", "required": true},
    {"id": "providerSecret", "label": "Provider secret", "type": "secretref", "required": true},
    {"id": "webhookSecret", "label": "Webhook secret", "type": "secretref", "required": true},
    {"id": "accountId", "label": "Fixture account", "type": "text", "required": true}
  ],
  "permissions": {
    "contributesKnowledgeSources": true,
    "requiresSharedDatasetAccess": false,
    "requiresDeploymentSecrets": true
  },
  "contributions": {
    "entityConfig": {
      "ai-entities": {
        "verification-vehicle-a": {
          "indexing": {"enabled": true, "max-characters": 8000},
          "analysis": {"enabled": false, "after": []},
          "searchable-fields": [
            {
              "name": "content",
              "destinations": ["SEMANTIC_SEARCH", "RAG_CONTEXT"],
              "preprocessing": "CLEAN",
              "max-length": 8000,
              "priority": 100,
              "required": true
            }
          ],
          "metadata-fields": [
            {"name": "tenantId", "data-type": "ID", "destinations": ["VECTOR_METADATA"], "priority": 100, "required": true, "sanitize-pii": false},
            {"name": "deploymentId", "data-type": "ID", "destinations": ["VECTOR_METADATA"], "priority": 100, "required": true, "sanitize-pii": false},
            {"name": "sourceId", "data-type": "ID", "destinations": ["VECTOR_METADATA"], "priority": 90, "required": true, "sanitize-pii": false}
          ]
        }
      }
    },
    "datasets": [
      {
        "datasetId": "verification-vehicle-profile-a",
        "entityType": "verification-vehicle-a",
        "storageScope": "CUSTOMER_MANAGED",
        "sharingScope": "DEPLOYMENT_ONLY",
        "ingestionMode": "EXTERNAL_SYNC_HTTP",
        "updateStrategy": "UPSERT_BY_ID",
        "syncConnector": {
          "connectorType": "HTTP_JSON",
          "connectionProfile": {
            "profileId": "verification-profile-a",
            "environment": "verification",
            "baseUrl": "__SIMULATOR_BASE_URL__",
            "allowedHosts": ["__SIMULATOR_HOST__"],
            "auth": {
              "strategy": "FORM_TOKEN_EXCHANGE",
              "tokenBaseUrl": "__SIMULATOR_BASE_URL__",
              "tokenPath": "/api/profile-a/authenticate",
              "tokenMethod": "POST",
              "credentialFields": [
                {"name": "key", "secretRefField": "providerKey"},
                {"name": "secret", "secretRefField": "providerSecret"}
              ],
              "tokenJsonPointer": "/access_token",
              "absoluteExpiryJsonPointer": "/expires_at",
              "authorizationHeader": "Authorization",
              "authorizationScheme": "Bearer",
              "expirySkewSeconds": 30,
              "timeoutMs": 5000
            },
            "ratePolicy": {
              "maxConcurrent": 2,
              "minIntervalMs": 0,
              "rateLimitedPauseMs": 1000,
              "unavailablePauseMs": 500,
              "maxAttempts": 2,
              "retryBackoffMs": 100,
              "retryStatuses": [429, 503]
            },
            "errorMappings": [
              {"status": 403, "bodyJsonPointer": "/code", "equalsValue": "CAPABILITY_DENIED", "errorClass": "CAPABILITY_DENIED"}
            ],
            "capabilityGrants": ["vehicles:read"],
            "correlationResponseHeaders": ["X-Simulator-Request"]
          },
          "protectedResource": {
            "bindingId": "verification-account-a",
            "environment": "verification",
            "resourceType": "vehicle-account",
            "resourceIdField": "accountId",
            "policyRef": "single-verification-account",
            "capabilityGrants": ["vehicles:read"]
          },
          "httpSource": {
            "sourceId": "verification-vehicle-source-a",
            "path": "/api/profile-a/vehicles",
            "method": "GET",
            "completeHttpStatuses": [200],
            "trustedResourcePlacements": [{"target": "QUERY", "field": "account"}],
            "requiredCapabilityGrants": ["vehicles:read"],
            "pagination": {
              "strategy": "PAGE_SIZE",
              "pageQuery": "page",
              "sizeQuery": "pageSize",
              "startPage": 1,
              "pageSize": 2,
              "maxPages": 20
            },
            "mapping": {
              "recordsJsonPointer": "/items",
              "idJsonPointer": "/id",
              "resourceJsonPointer": "/accountId",
              "contentFields": {
                "title": "/title",
                "make": "/make",
                "model": "/model",
                "derivative": "/derivative",
                "fuelType": "/fuelType",
                "bodyStyle": "/bodyStyle",
                "state": "/state"
              },
              "entityFields": {
                "make": "/make",
                "model": "/model",
                "derivative": "/derivative",
                "year": "/year",
                "priceMinor": "/priceMinor",
                "currency": "/currency",
                "fuelType": "/fuelType",
                "bodyStyle": "/bodyStyle",
                "transmission": "/transmission",
                "mileage": "/mileage",
                "state": "/state"
              },
              "metadataFields": {
                "providerUpdatedAt": "/updatedAt",
                "providerRecordVersion": "/version"
              },
              "maxRecords": 100,
              "maxResponseBytes": 1048576
            },
            "tombstonePolicy": {
              "strategy": "ABSENT_OR_FIELD_VALUE",
              "operationJsonPointer": "/state",
              "deleteValues": ["deleted"]
            },
            "scheduleSeconds": 30
          },
          "webhook": {
            "sourceId": "verification-vehicle-events-a",
            "method": "POST",
            "allowedContentTypes": ["application/json"],
            "verification": {
              "strategy": "HMAC_SHA256_TIMESTAMP_DOT_RAW_BODY",
              "signatureHeader": "X-Simulator-A-Signature",
              "secretRefField": "webhookSecret",
              "timestampComponent": "t",
              "signatureComponent": "v1",
              "replayWindowSeconds": 300
            },
            "eventIdJsonPointer": "/eventId",
            "eventTypeJsonPointer": "/eventType",
            "resourceJsonPointer": "/accountId",
            "allowedEventTypes": ["vehicle.changed"],
            "maxBodyBytes": 1048576,
            "maxReconcileAttempts": 3,
            "retryDelaySeconds": 10,
            "registrationExpected": true,
            "manualReplayEnabled": true,
            "orderingPolicy": "RECONCILE_LATEST_STATE"
          }
        }
      }
    ],
    "knowledgeSources": [
      {
        "sourceType": "deployment-private-vector",
        "sourceKey": "verification-vehicles-a",
        "adapterType": "deployment-private-vector",
        "datasetRef": "verification-vehicle-profile-a",
        "entityType": "verification-vehicle-a",
        "attributionLabel": "Internal verification vehicle source A"
      }
    ]
  }
}
