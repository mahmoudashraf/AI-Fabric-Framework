{
  "schemaVersion": 1,
  "pluginId": "mkp-action-autotrader-contract-verification",
  "version": "1.0.0",
  "pluginType": "ACTION",
  "displayName": "Internal Auto Trader Contract Verification Actions",
  "description": "Internal-only read actions for synthetic dealership stock exposed through the documented Auto Trader Stock API shape. It is not an Auto Trader service or endorsement.",
  "compatibility": {
    "requiredCapabilities": ["actions"],
    "supportedDeploymentTargets": ["custom-start-from-scratch"]
  },
  "pricing": {"pricingModel": "FREE"},
  "permissions": {
    "contributesActions": true,
    "requiresExternalHttpExecution": true
  },
  "contributions": {
    "actions": [
      {
        "actionId": "dealership_search_inventory",
        "adapterType": "connector-http",
        "description": "Read the dealership account's current provider stock and apply the buyer's stated preferences to the returned facts.",
        "category": "dealership_inventory",
        "readOnly": true,
        "anonymousAllowed": true,
        "requiresConfirmation": false,
        "groundingEligible": true,
        "readActionResolutionEligible": true,
        "llmFacts": {
          "lists": [
            {
              "sourcePath": "results",
              "target": "items",
              "maxItems": 24,
              "includeFields": ["vehicle", "advertiser", "adverts", "metadata", "features"]
            }
          ]
        },
        "params": [
          {"name": "make", "description": "Exact make filter when the buyer specified one.", "type": "STRING", "required": false},
          {"name": "fuelType", "description": "Exact buyer-stated fuel type.", "type": "STRING", "required": false},
          {"name": "bodyType", "description": "Exact buyer-stated body type.", "type": "STRING", "required": false},
          {"name": "maxPriceGbp", "description": "Maximum whole-pound budget stated by the buyer.", "type": "INTEGER", "required": false},
          {"name": "maxMileage", "description": "Maximum odometer mileage stated by the buyer.", "type": "INTEGER", "required": false},
          {"name": "limit", "description": "Maximum number of vehicles to return.", "type": "INTEGER", "required": false, "min": 1, "max": 24}
        ],
        "route": {
          "connectionProfileRef": "autotrader-stock-provider",
          "protectedResourceBindingRef": "autotrader-dealership-account",
          "requiredCapabilityGrants": ["stock:read"],
          "trustedResourcePlacements": [
            {"target": "QUERY", "field": "advertiserId"}
          ],
          "method": "GET",
          "path": "/stock",
          "request": {"query": {"lifecycleState": "FORECOURT", "page": 1, "pageSize": 200}},
          "response": {
            "success-http-status": [200],
            "collection-filters": [
              {
                "collection-json-pointer": "/results",
                "count-json-pointer": "/totalResults",
                "inclusion-conditions": [
                  {
                    "json-pointer": "/adverts/retailAdverts/advertiserAdvert/status",
                    "allowed-values": ["PUBLISHED"]
                  }
                ]
              }
            ],
            "result": {
              "_items": "{{body.results}}",
              "_count": "{{body.totalResults}}",
              "results": "{{body.results}}",
              "total": "{{body.totalResults}}",
              "source": {"label": "Fictional Auto Trader contract-simulator stock"},
              "dataNotice": "Synthetic demonstration records returned through the documented Auto Trader Stock API response shape."
            },
            "message": "Provider stock search completed."
          }
        }
      },
      {
        "actionId": "dealership_get_vehicle",
        "adapterType": "connector-http",
        "description": "Load one current provider stock record by a trusted stock ID resolved from attached context or an earlier result.",
        "category": "dealership_inventory",
        "readOnly": true,
        "anonymousAllowed": true,
        "requiresConfirmation": false,
        "groundingEligible": true,
        "readActionResolutionEligible": true,
        "llmFacts": {
          "objects": [
            {
              "sourcePath": "vehicleRecord",
              "target": "vehicle",
              "includeFields": ["vehicle", "advertiser", "adverts", "metadata", "features"]
            }
          ]
        },
        "params": [
          {
            "name": "vehicle",
            "description": "Exact provider stock ID from trusted attached context or an earlier provider result. Do not ask the buyer for this internal value.",
            "type": "STRING",
            "required": true
          }
        ],
        "route": {
          "connectionProfileRef": "autotrader-stock-provider",
          "protectedResourceBindingRef": "autotrader-dealership-account",
          "requiredCapabilityGrants": ["stock:read"],
          "trustedResourcePlacements": [
            {"target": "QUERY", "field": "advertiserId"}
          ],
          "method": "GET",
          "path": "/stock",
          "request": {
            "query": {"stockId": "{{params.vehicle}}", "lifecycleState": "FORECOURT", "page": 1, "pageSize": 1}
          },
          "response": {
            "success-http-status": [200],
            "collection-filters": [
              {
                "collection-json-pointer": "/results",
                "count-json-pointer": "/totalResults",
                "inclusion-conditions": [
                  {
                    "json-pointer": "/adverts/retailAdverts/advertiserAdvert/status",
                    "allowed-values": ["PUBLISHED"]
                  }
                ]
              }
            ],
            "result": {
              "_items": "{{body.results}}",
              "_count": "{{body.totalResults}}",
              "vehicleRecord": "{{body.results[0]}}",
              "total": "{{body.totalResults}}",
              "source": {
                "label": "Fictional Auto Trader contract-simulator stock",
                "refreshedAt": "{{body.results[0].metadata.lastUpdated}}"
              },
              "dataNotice": "Synthetic demonstration record returned through the documented Auto Trader Stock API response shape."
            },
            "message": "Current provider stock details loaded."
          }
        }
      }
    ]
  }
}
