{
  "schemaVersion": 1,
  "pluginId": "mkp-action-autotrader-contract-verification",
  "version": "1.3.1",
  "pluginType": "ACTION",
  "displayName": "Internal Auto Trader Contract Verification Actions",
  "description": "Internal-only read actions for synthetic dealership stock exposed through the documented Auto Trader Stock API shape. It is not an Auto Trader service or endorsement.",
  "compatibility": {
    "requiredCapabilities": ["actions"],
    "supportedDeploymentTargets": ["custom-start-from-scratch"]
  },
  "pricing": {"pricingModel": "FREE"},
  "permissions": {
    "contributesActions": true,
    "requiresExternalHttpExecution": false
  },
  "contributions": {
    "actions": [
      {
        "actionId": "dealership_search_inventory",
        "adapterType": "connector-http",
        "description": "Query the dealership deployment's synchronized current-stock projection and apply every buyer preference as a typed filter.",
        "category": "dealership_inventory",
        "readOnly": true,
        "anonymousAllowed": true,
        "requiresConfirmation": false,
        "groundingEligible": true,
        "readActionResolutionEligible": true,
        "llmFacts": {
          "lists": [
            {
              "sourcePath": "results",
              "target": "items",
              "maxItems": 24,
              "includeFields": ["stockId", "make", "model", "derivative", "year", "priceGbp", "mileage", "fuelType", "transmission", "bodyType", "availability", "advertStatus", "features", "imageId", "imageUrl"]
            }
          ]
        },
        "params": [
          {"name": "make", "description": "Exact make filter when the buyer specified one.", "type": "STRING", "required": false},
          {"name": "fuelType", "description": "Exact buyer-stated fuel type.", "type": "STRING", "required": false},
          {"name": "bodyType", "description": "Exact buyer-stated body type.", "type": "STRING", "required": false},
          {"name": "maxPriceGbp", "description": "Maximum whole-pound budget stated by the buyer.", "type": "INTEGER", "required": false},
          {"name": "maxMileage", "description": "Maximum odometer mileage stated by the buyer.", "type": "INTEGER", "required": false},
          {"name": "limit", "description": "Maximum number of vehicles to return.", "type": "INTEGER", "required": false, "min": 1, "max": 24}
        ],
        "route": {
          "sourceProjection": {
            "sourceRef": "autotrader-dealership-stock-source",
            "filters": [
              {"param": "make", "fields": ["make"], "operator": "EQUALS_IGNORE_CASE"},
              {"param": "fuelType", "fields": ["fuelType"], "operator": "EQUALS_IGNORE_CASE"},
              {"param": "bodyType", "fields": ["bodyType"], "operator": "EQUALS_IGNORE_CASE"},
              {"param": "maxPriceGbp", "fields": ["priceGbp"], "operator": "NUMBER_LESS_THAN_OR_EQUAL"},
              {"param": "maxMileage", "fields": ["mileage"], "operator": "NUMBER_LESS_THAN_OR_EQUAL"}
            ],
            "outputFields": ["stockId", "make", "model", "derivative", "year", "priceGbp", "mileage", "fuelType", "transmission", "bodyType", "availability", "advertStatus", "features", "imageId", "imageUrl"],
            "limitParam": "limit",
            "defaultLimit": 10,
            "maxLimit": 24,
            "requireSuccessfulSync": true,
            "maxStalenessSeconds": 1800
          },
          "response": {
            "result": {
              "_items": "{{body.results}}",
              "_count": "{{body.returnedCount}}",
              "_totalCount": "{{body.totalResults}}",
              "results": "{{body.results}}",
              "total": "{{body.totalResults}}",
              "appliedFilters": "{{body.appliedFilters}}",
              "source": "{{body.source}}",
              "dataNotice": "Synthetic demonstration records returned through the documented Auto Trader Stock API response shape."
            },
            "pinnedTargetsFromCollection": {
              "collectionJsonPointer": "/results",
              "idJsonPointer": "/stockId",
              "vectorSpace": "dealer-vehicle",
              "contentFields": {
                "make": "/make",
                "model": "/model",
                "derivative": "/derivative",
                "year": "/year",
                "priceGbp": "/priceGbp",
                "mileage": "/mileage",
                "fuelType": "/fuelType",
                "transmission": "/transmission",
                "bodyType": "/bodyType",
                "availability": "/availability"
              },
              "metadataFields": {
                "stockId": "/stockId",
                "make": "/make",
                "model": "/model",
                "year": "/year",
                "imageUrl": "/imageUrl"
              },
              "maxTargets": 8,
              "maxContentChars": 1200
            },
            "message": "Provider stock search completed."
          },
          "authz": {
            "enabled": true,
            "resourceId": "inventory-search",
            "operationType": "SEARCH"
          }
        }
      },
      {
        "actionId": "dealership_get_vehicle",
        "adapterType": "connector-http",
        "description": "Load one current synchronized stock record only when a trusted attached or conversation working target supplies its provider stock ID. A buyer-facing name in a new request is discovery input and must use inventory search instead.",
        "category": "dealership_inventory",
        "readOnly": true,
        "anonymousAllowed": true,
        "requiresConfirmation": false,
        "groundingEligible": true,
        "readActionResolutionEligible": true,
        "llmFacts": {
          "objects": [
            {
              "sourcePath": "vehicleRecord",
              "target": "vehicle",
              "includeFields": ["stockId", "make", "model", "derivative", "year", "priceGbp", "mileage", "fuelType", "transmission", "bodyType", "availability", "advertStatus", "features", "imageId", "imageUrl"]
            }
          ]
        },
        "params": [
          {
            "name": "vehicle",
            "description": "Exact provider stock ID from trusted attached context or an earlier provider result. Do not ask the buyer for this internal value.",
            "type": "STRING",
            "required": true,
            "visibility": "INTERNAL",
            "askUser": false,
            "resolveFrom": {
              "source": "ATTACHMENT_METADATA",
              "metadataKeys": ["stockId", "vehicleId", "id"]
            },
            "evidenceBound": true,
            "evidenceKeys": ["stockId", "vehicleId", "id"],
            "evidenceFallbackPolicy": "CLARIFY"
          }
        ],
        "route": {
          "sourceProjection": {
            "sourceRef": "autotrader-dealership-stock-source",
            "filters": [
              {"param": "vehicle", "fields": ["stockId"], "operator": "EQUALS_IGNORE_CASE"}
            ],
            "outputFields": ["stockId", "make", "model", "derivative", "year", "priceGbp", "mileage", "fuelType", "transmission", "bodyType", "availability", "advertStatus", "features", "imageId", "imageUrl"],
            "defaultLimit": 1,
            "maxLimit": 1,
            "requireSuccessfulSync": true,
            "maxStalenessSeconds": 1800
          },
          "response": {
            "result": {
              "_items": "{{body.results}}",
              "_count": "{{body.returnedCount}}",
              "_totalCount": "{{body.totalResults}}",
              "vehicleRecord": "{{body.results[0]}}",
              "total": "{{body.totalResults}}",
              "source": "{{body.source}}",
              "dataNotice": "Synthetic demonstration record returned through the documented Auto Trader Stock API response shape."
            },
            "pinnedTargetsFromCollection": {
              "collectionJsonPointer": "/results",
              "idJsonPointer": "/stockId",
              "vectorSpace": "dealer-vehicle",
              "contentFields": {
                "make": "/make",
                "model": "/model",
                "derivative": "/derivative",
                "year": "/year",
                "priceGbp": "/priceGbp",
                "mileage": "/mileage",
                "fuelType": "/fuelType",
                "transmission": "/transmission",
                "bodyType": "/bodyType",
                "availability": "/availability",
                "features": "/features"
              },
              "metadataFields": {
                "stockId": "/stockId",
                "make": "/make",
                "model": "/model",
                "year": "/year",
                "imageUrl": "/imageUrl"
              },
              "maxTargets": 1,
              "maxContentChars": 1600
            },
            "message": "Current provider stock details loaded."
          },
          "authz": {
            "enabled": true,
            "resourceId": "{{params.vehicle}}",
            "operationType": "READ"
          }
        }
      }
    ]
  }
}
