# Non-secret 010.36 S3 canary contract.
S3_CANARY_BUCKET=loomai-dealership-canary-978e0cdb142540e2
S3_CANARY_REGION=eu-north-1
S3_CANARY_ENDPOINT=https://s3.eu-north-1.amazonaws.com
S3_CANARY_VERSIONING_ENABLED=false
S3_CANARY_STAGING_PREFIX=dealership/staging/
S3_CANARY_PRODUCTION_PREFIX=dealership/production/

# Supply separate prefix-limited identities in an ignored .env file or through
# the process environment. Never add real values to this example.
S3_CANARY_STAGING_ACCESS_KEY_ID=
S3_CANARY_STAGING_SECRET_ACCESS_KEY=
S3_CANARY_STAGING_SESSION_TOKEN=
S3_CANARY_PRODUCTION_ACCESS_KEY_ID=
S3_CANARY_PRODUCTION_SECRET_ACCESS_KEY=
S3_CANARY_PRODUCTION_SESSION_TOKEN=
