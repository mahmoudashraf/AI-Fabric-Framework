---
import { ArrowRight, ExternalLink, GitFork } from '@lucide/astro'
import { Image } from 'astro:assets'
import ArchitectureFlow from '../components/ArchitectureFlow.astro'
import CallToAction from '../components/CallToAction.astro'
import ExperimentCard from '../components/ExperimentCard.astro'
import ProductCard from '../components/ProductCard.astro'
import ResearchCard from '../components/ResearchCard.astro'
import SectionHeading from '../components/SectionHeading.astro'
import { experiments, products, research } from '../data/content'
import BaseLayout from '../layouts/BaseLayout.astro'
import heroImage from '../assets/loom-woven-hero.png'

const featuredExperiments = experiments.filter((item) => item.featured).slice(0, 3)
const featuredResearch = research.filter((item) => item.featured).slice(0, 3)
---

<BaseLayout>
  <section class="home-hero">
    <Image
      class="home-hero__art"
      src={heroImage}
      alt=""
      format="webp"
      quality={86}
      widths={[768, 1280, 1716]}
      sizes="100vw"
      fetchpriority="high"
      decoding="async"
    />
    <div class="loom-container home-hero__inner">
      <div class="home-hero__copy">
        <p class="loom-eyebrow">Open-source AI engineering</p>
        <h1>Loom AI Labs</h1>
        <p class="home-hero__statement">We weave intelligence into real software.</p>
        <p class="home-hero__body">
          Open-source products, live experiments and applied research for dependable
          AI-enabled applications.
        </p>
        <div class="button-group">
          <a class="loom-button loom-button--primary" href="/products">
            Explore products
            <ArrowRight size={17} aria-hidden="true" />
          </a>
          <a class="loom-button loom-button--secondary" href="/experiments">
            View live experiments
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="loom-container">
      <SectionHeading
        eyebrow="Products from the lab"
        title="Two open-source layers for one application boundary."
        body="The framework enables grounded, governed AI behavior. The UI turns those backend contracts into a usable application experience."
      />
      <div class="product-grid">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="loom-container">
      <div class="relationship-layout">
        <div>
          <p class="loom-eyebrow">Built to work together</p>
          <h2>Application control stays visible from data to interface.</h2>
        </div>
        <p>
          AI Fabric Framework governs application data, retrieval and actions. AI
          Fabric Chat UI presents those capabilities through a reusable application
          experience.
        </p>
      </div>
      <ArchitectureFlow
        steps={['Application data', 'AI Fabric Framework', 'Backend contracts', 'AI Fabric Chat UI']}
        label="How the two AI Fabric products connect"
      />
    </div>
  </section>

  <section class="section section--white">
    <div class="loom-container">
      <div class="section-heading-row">
        <SectionHeading
          eyebrow="Runnable engineering proof"
          title="Featured live experiments"
          body="Bounded applications that expose what can be inspected, what stays application-owned and what remains deliberately unclaimed."
        />
        <a class="text-link" href="/experiments">
          All experiments
          <ArrowRight size={17} aria-hidden="true" />
        </a>
      </div>
      <div class="experiment-grid">
        {featuredExperiments.map((experiment) => <ExperimentCard experiment={experiment} />)}
      </div>
    </div>
  </section>

  <section class="section research-home">
    <div class="loom-container">
      <div class="section-heading-row">
        <SectionHeading
          eyebrow="Implementation-linked"
          title="Applied research"
          body="Engineering investigations with public implementation artifacts, explicit evidence levels and stated limitations."
        />
        <a class="text-link" href="/research">
          All research
          <ArrowRight size={17} aria-hidden="true" />
        </a>
      </div>
      <div class="research-grid">
        {featuredResearch.map((item) => <ResearchCard item={item} />)}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="loom-container open-source-band">
      <div class="open-source-band__lead">
        <GitFork size={30} stroke-width={1.6} aria-hidden="true" />
        <p class="loom-eyebrow">Built in the open</p>
        <h2>Inspect the source, run the proof, question the boundary.</h2>
      </div>
      <div class="open-source-band__facts">
        <div>
          <strong>Source-linked</strong>
          <p>Product and experiment pages link to the implementation they describe.</p>
        </div>
        <div>
          <strong>Reproducible</strong>
          <p>Live proofs use bounded scenarios and state their data and environment limits.</p>
        </div>
        <div>
          <strong>Application-owned</strong>
          <p>Identity, business policy and execution remain explicit host responsibilities.</p>
        </div>
      </div>
      <a
        class="loom-button loom-button--secondary"
        href="https://github.com/Loom-AI-Labs"
        target="_blank"
        rel="noreferrer"
      >
        Visit GitHub
        <ExternalLink size={16} aria-hidden="true" />
      </a>
    </div>
  </section>

  <CallToAction
    title="Bring a real application problem."
    body="Discuss framework adoption, UI integration, a reproducible experiment or an engineering research question."
  />
</BaseLayout>

<style>
  .home-hero {
    align-items: center;
    background: #fbfcff;
    border-bottom: 1px solid var(--loom-border-subtle);
    display: flex;
    min-height: min(48rem, calc(100svh - var(--loom-header-height) - 4rem));
    overflow: hidden;
    position: relative;
  }

  .home-hero::after {
    background: linear-gradient(90deg, var(--loom-blue-600), var(--loom-violet-500));
    bottom: 0;
    content: "";
    height: 2px;
    left: 0;
    opacity: 0.8;
    position: absolute;
    width: 42%;
  }

  .home-hero__art {
    height: 100%;
    inset: 0;
    object-fit: cover;
    object-position: center;
    position: absolute;
    width: 100%;
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
  }

  .home-hero__copy {
    max-width: min(42rem, 50%);
    padding-block: 5rem;
  }

  .home-hero h1 {
    font-size: var(--loom-text-hero);
    margin-bottom: 0.4rem;
  }

  .home-hero__statement {
    color: var(--loom-text-primary);
    font-size: clamp(1.65rem, 2.65vw, 2.65rem);
    font-weight: 680;
    line-height: 1.18;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }

  .home-hero__body {
    font-size: var(--loom-text-body-lg);
    margin-bottom: 2rem;
    max-width: 52ch;
  }

  .relationship-layout {
    align-items: end;
    display: grid;
    gap: 3rem;
    grid-template-columns: 1.1fr 0.9fr;
    margin-bottom: 3rem;
  }

  .relationship-layout h2 {
    margin-bottom: 0;
    max-width: 18ch;
  }

  .relationship-layout > p {
    font-size: var(--loom-text-body-lg);
    margin: 0;
  }

  .section-heading-row {
    align-items: end;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .section-heading-row :global(.section-heading) {
    margin-bottom: 0;
  }

  .research-home {
    background:
      linear-gradient(180deg, rgb(248 250 255 / 95%), rgb(244 247 255 / 98%)),
      repeating-linear-gradient(90deg, transparent 0 79px, rgb(20 108 255 / 4%) 80px);
    border-block: 1px solid var(--loom-border-subtle);
  }

  .open-source-band {
    align-items: start;
    display: grid;
    gap: 3rem;
    grid-template-columns: 1fr 1.6fr auto;
  }

  .open-source-band__lead > svg {
    color: var(--loom-blue-600);
    margin-bottom: 1.5rem;
  }

  .open-source-band__lead h2 {
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    margin-bottom: 0;
  }

  .open-source-band__facts {
    display: grid;
    gap: 1.5rem;
  }

  .open-source-band__facts div {
    border-bottom: 1px solid var(--loom-border-default);
    padding-bottom: 1.25rem;
  }

  .open-source-band__facts strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .open-source-band__facts p {
    font-size: var(--loom-text-small);
    margin: 0;
  }

  @media (max-width: 64rem) {
    .home-hero {
      min-height: auto;
    }

    .home-hero__art {
      height: auto;
      object-position: 62% center;
      opacity: 0.52;
    }

    .home-hero__copy {
      max-width: 62%;
    }

    .open-source-band {
      grid-template-columns: 1fr 1fr;
    }

    .open-source-band > a {
      grid-column: 1 / -1;
      width: fit-content;
    }
  }

  @media (max-width: 47.99rem) {
    .home-hero {
      align-items: start;
      display: block;
      padding-bottom: 16rem;
    }

    .home-hero__art {
      bottom: 0;
      height: 20rem;
      object-position: 72% center;
      opacity: 1;
      top: auto;
    }

    .home-hero__copy {
      max-width: none;
      padding-block: 4rem 2rem;
    }

    .relationship-layout,
    .open-source-band {
      grid-template-columns: 1fr;
    }

    .section-heading-row {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
