---
import BusinessExperienceCatalogue from '../components/BusinessExperienceCatalogue.astro'
import BusinessExperienceFamily from '../components/BusinessExperienceFamily.astro'
import BusinessExperienceHero from '../components/BusinessExperienceHero.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="AI Customer Experience"
  description="Help customers find answers, choose confidently and take the next step. Explore LoomAI experiences with your brand, your business information and optional human support."
>
  <div class="business-home">
    <BusinessExperienceHero />
    <BusinessExperienceCatalogue />
    <BusinessExperienceFamily />
  </div>
</BaseLayout>

<style>
  :global(body:has(.business-home)) {
    background: var(--loom-canvas);
  }
</style>
