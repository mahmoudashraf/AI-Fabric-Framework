---
import ArchitectureFlow from '../../components/ArchitectureFlow.astro'
import CallToAction from '../../components/CallToAction.astro'
import ExperimentCard from '../../components/ExperimentCard.astro'
import LabProductShowcase from '../../components/LabProductShowcase.astro'
import PageHero from '../../components/PageHero.astro'
import SectionHeading from '../../components/SectionHeading.astro'
import { experiments } from '../../data/content'
import BaseLayout from '../../layouts/BaseLayout.astro'

const platformDemos = experiments.filter((item) =>
  item.relatedProductSlugs.includes('loomai-platform'),
)
---

<BaseLayout
  title="Products"
  description="LoomAI Platform and its AI Fabric Framework and Chat UI foundations for dependable AI-enabled applications."
  canonicalPath="/products"
>
  <PageHero
    eyebrow="AI enablement portfolio"
    title="Products"
    body="Build grounded, governed AI behavior, present it through a reusable application experience and operate it as a verified customer deployment."
    note="One managed platform · Two open-source foundations · Explicit ownership boundaries"
  />

  <section class="product-showcase" aria-labelledby="product-portfolio">
    <div class="loom-container">
      <LabProductShowcase heading="Products from the lab" headingId="product-portfolio" />
    </div>
  </section>

  <section class="section section--soft">
    <div class="loom-container">
      <SectionHeading
        eyebrow="Responsibility boundaries"
        title="Adopt the layer you need without relocating application authority."
        body="The framework and UI solve different parts of the product surface. Neither replaces identity, authorization, domain policy or business execution."
      />
      <div class="product-comparison">
        <div class="product-comparison__heading">
          <span>Responsibility</span>
          <strong>LoomAI Platform</strong>
          <strong>AI Fabric Framework</strong>
          <strong>AI Fabric Chat UI</strong>
        </div>
        <div>
          <span>Capability composition</span>
          <strong>Templates, plugins and profiles</strong>
          <span>Supplies runtime contracts</span>
          <span>Supplies experience contracts</span>
        </div>
        <div>
          <span>Grounding and retrieval behavior</span>
          <span>Packages and deploys</span>
          <strong>Owns</strong>
          <span>Renders evidence</span>
        </div>
        <div>
          <span>Action lifecycle contracts</span>
          <span>Packages and verifies</span>
          <strong>Owns</strong>
          <span>Renders proposal and confirmation</span>
        </div>
        <div>
          <span>Conversation presentation</span>
          <span>Distributes reviewed experiences</span>
          <span>Returns backend state</span>
          <strong>Owns</strong>
        </div>
        <div>
          <span>Release and deployment lifecycle</span>
          <strong>Owns</strong>
          <span>Provides versioned artifacts</span>
          <span>Provides versioned artifacts</span>
        </div>
        <div>
          <span>Customer identity and business authority</span>
          <span>Customer application</span>
          <span>Host application</span>
          <span>Host application</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="loom-container">
      <SectionHeading
        eyebrow="Architecture"
        title="From application context to user-visible evidence."
      />
      <ArchitectureFlow
        steps={['AI Fabric Framework + Chat UI', 'LoomAI Platform composition', 'Verified customer deployment', 'Customer application']}
      />
    </div>
  </section>

  {platformDemos.length > 0 && (
    <section class="section platform-demo-band">
      <div class="loom-container">
        <SectionHeading
          eyebrow="Platform live demos"
          title="See a customer product use its assigned LoomAI deployment."
          body="These demos exercise Platform-created deployments, deployment-local APIs, reviewed Marketplace packages and reusable customer experience surfaces."
        />
        <div class="experiment-grid platform-demo-grid">
          {platformDemos.map((item) => <ExperimentCard experiment={item} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--soft">
    <div class="loom-container">
      <SectionHeading
        eyebrow="Related proof"
        title="See the products operating in bounded applications."
        body="Each experiment links to source and states what its scenario does and does not demonstrate."
      />
      <div class="experiment-grid">
        {experiments.filter((item) => item.featured).slice(0, 3).map((item) => (
          <ExperimentCard experiment={item} />
        ))}
      </div>
    </div>
  </section>

  <CallToAction
    eyebrow="Choose the right layer"
    title="Use the foundations directly or operate them through LoomAI Platform."
    body="The Framework and Chat UI remain inspectable open-source products. Platform adds managed composition, deployment lifecycle and verification around them."
    primaryLabel="Explore LoomAI Platform"
    primaryHref="/products/loomai-platform"
    secondaryLabel="Visit Loom AI Labs on GitHub"
    secondaryHref="https://github.com/Loom-AI-Labs"
  />
</BaseLayout>

<style>
  .product-showcase {
    background: var(--loom-canvas);
    padding-block: 2rem 1.5rem;
    position: relative;
  }

  .product-showcase::after {
    background-image:
      linear-gradient(rgb(20 108 255 / 3.5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(20 108 255 / 3.5%) 1px, transparent 1px);
    background-size: 48px 48px;
    content: "";
    inset: 0;
    mask-image: linear-gradient(90deg, transparent 42%, #000 100%);
    pointer-events: none;
    position: absolute;
  }

  .product-showcase > .loom-container {
    position: relative;
    z-index: 1;
  }

  .product-comparison {
    background: var(--loom-surface);
    border: 1px solid var(--loom-border-default);
    border-radius: var(--loom-radius-md);
    overflow: hidden;
  }

  .product-comparison > div {
    align-items: center;
    border-bottom: 1px solid var(--loom-border-default);
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1.15fr repeat(3, minmax(0, 1fr));
    min-height: 4.5rem;
    padding-inline: 1.5rem;
  }

  .product-comparison > div:last-child {
    border-bottom: 0;
  }

  .product-comparison__heading {
    background: var(--loom-navy-950);
    color: #fff;
    font-size: 0.85rem;
  }

  .product-comparison > div:not(.product-comparison__heading) > span {
    color: var(--loom-text-secondary);
  }

  .product-comparison > div:not(.product-comparison__heading) > :not(:first-child) {
    font-size: 0.9rem;
  }

  .platform-demo-band {
    background: #f8fbff;
    border-block: 1px solid var(--loom-border-subtle);
  }

  .platform-demo-grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
  }

  .platform-demo-grid :global(.experiment-card) {
    grid-column: span 2;
  }

  @media (max-width: 47.99rem) {
    .product-comparison {
      background: transparent;
      border: 0;
      display: grid;
      gap: 1rem;
      overflow: visible;
    }

    .product-comparison > div {
      background: var(--loom-surface);
      border: 1px solid var(--loom-border-default);
      grid-template-columns: 1fr;
      padding-block: 1rem;
    }

    .product-comparison__heading {
      display: none !important;
    }

    .product-comparison > div:not(.product-comparison__heading) > :nth-child(2)::before,
    .product-comparison > div:not(.product-comparison__heading) > :nth-child(3)::before,
    .product-comparison > div:not(.product-comparison__heading) > :nth-child(4)::before {
      color: var(--loom-blue-600);
      display: block;
      font-size: 0.62rem;
      font-weight: 750;
      letter-spacing: 0.06em;
      margin-bottom: 0.2rem;
      text-transform: uppercase;
    }

    .product-comparison > div:not(.product-comparison__heading) > :nth-child(2)::before {
      content: "LoomAI Platform";
    }

    .product-comparison > div:not(.product-comparison__heading) > :nth-child(3)::before {
      content: "AI Fabric Framework";
    }

    .product-comparison > div:not(.product-comparison__heading) > :nth-child(4)::before {
      content: "AI Fabric Chat UI";
    }

    .platform-demo-grid {
      grid-template-columns: 1fr;
    }

    .platform-demo-grid :global(.experiment-card) {
      grid-column: auto;
    }
  }
</style>
