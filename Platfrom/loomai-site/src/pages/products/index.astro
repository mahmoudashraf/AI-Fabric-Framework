---
import { ArrowRight, Play } from '@lucide/astro'
import ProductPortfolioLayers from '../../components/ProductPortfolioLayers.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Products"
  description="Start with a business or industry AI experience kit. Bring it to customers with LoomAI Engage and optional Desk, powered by LoomAI Platform and open-source foundations."
  canonicalPath="/products"
>
  <header class="portfolio-intro loom-container">
    <p class="loom-eyebrow">The LoomAI family</p>
    <h1>Products</h1>
    <p class="portfolio-intro__lead">Start with an experience. Make it yours.</p>
    <p>Ready-made kits, connected products and the technology that brings them together.</p>
  </header>

  <ProductPortfolioLayers />

  <section class="portfolio-demo" aria-labelledby="portfolio-demo-title">
    <div class="loom-container portfolio-demo__inner">
      <a class="portfolio-demo__image" href="/demos/dealership-ai" aria-label="Try the dealership simulator demo"><img src="/assets/platform/dealership-ai-workspace-video-poster.jpg" alt="Northfield's illustrative dealership AI workspace" width="280" height="157" loading="lazy" /><span><Play size={19} aria-hidden="true" />Try the demo</span></a>
      <div><p class="loom-eyebrow">See it come together</p><h2 id="portfolio-demo-title">One dealership. A connected AI experience.</h2><p>Explore fictional stock, compare cars and ask for help in a branded workspace.</p><div class="portfolio-demo__links"><a href="/demos/dealership-ai">Try dealership demo<ArrowRight size={16} aria-hidden="true" /></a><a href="/experiences">Explore experience kits<ArrowRight size={16} aria-hidden="true" /></a></div><small>Simulator data, not a live dealership or Auto Trader account.</small></div>
    </div>
  </section>

  <section class="portfolio-start"><div class="loom-container"><div><h2>Your brand. Your business. Your AI experience.</h2><p>Choose a kit, then connect the information and tools your customers need.</p></div><a class="loom-button loom-button--primary" href="https://console.loomai.pro/">Open console<ArrowRight size={17} aria-hidden="true" /></a></div></section>
</BaseLayout>

<style>
  .portfolio-intro { padding-block: 2.5rem 2rem; }
  h1 { font-size: 2.75rem; line-height: 1.15; margin-bottom: 0.85rem; }
  .portfolio-intro__lead { color: var(--loom-text-primary); font-size: 1.35rem; font-weight: 600; line-height: 1.5; margin-bottom: 0.4rem; }
  .portfolio-intro > p:last-child { color: var(--loom-text-muted); font-size: 0.95rem; margin: 0; }
  .portfolio-demo { background: var(--loom-canvas); border-top: 1px solid var(--loom-border-default); padding-block: 2rem; }
  .portfolio-demo__inner { align-items: center; display: grid; gap: 2rem; grid-template-columns: 17.5rem minmax(0, 1fr); }
  .portfolio-demo__image { border: 1px solid var(--loom-border-default); border-radius: 6px; display: block; overflow: hidden; position: relative; text-decoration: none; }
  .portfolio-demo__image img { aspect-ratio: 16 / 9; display: block; object-fit: cover; width: 100%; }
  .portfolio-demo__image > span { align-items: center; background: var(--loom-surface); bottom: 0.6rem; color: var(--loom-text-primary); display: flex; font-size: 0.72rem; font-weight: 700; gap: 0.4rem; left: 0.6rem; padding: 0.3rem 0.6rem; }
  .portfolio-demo h2, .portfolio-start h2 { font-size: 1.3rem; line-height: 1.4; margin: 0 0 0.5rem; }
  .portfolio-demo p:not(.loom-eyebrow), .portfolio-start p { font-size: 0.85rem; margin: 0 0 0.75rem; }
  .portfolio-demo .loom-eyebrow { font-size: 0.65rem; margin-bottom: 0.45rem; }
  .portfolio-demo__links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; }
  .portfolio-demo__links a { align-items: center; color: var(--loom-blue-600); display: inline-flex; font-size: 0.8rem; font-weight: 700; gap: 0.4rem; text-decoration: none; }
  .portfolio-demo__links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .portfolio-demo small { color: var(--loom-text-muted); display: block; font-size: 0.69rem; margin-top: 0.7rem; }
  .portfolio-start { border-top: 1px solid var(--loom-border-default); padding-block: 2rem; }
  .portfolio-start > div { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem 2rem; justify-content: space-between; }
  .portfolio-start p { margin-bottom: 0; }
  @media (max-width: 39rem) { .portfolio-intro { padding-block: 1.75rem 1.5rem; } h1 { font-size: 2.25rem; } .portfolio-intro__lead { font-size: 1.15rem; } .portfolio-demo__inner { grid-template-columns: minmax(0, 1fr); gap: 1.2rem; } .portfolio-demo__image { max-width: 22rem; } }
</style>
