---
import {
  ArrowRight,
  Bot,
  CarFront,
  Check,
  ChevronRight,
  FileText,
  GitCompareArrows,
  Headphones,
  Leaf,
  MessageSquare,
  Paperclip,
  Search,
  Send,
} from '@lucide/astro'

type Props = {
  variant?: 'montage' | 'workspace' | 'dealership' | 'dealership-band'
}
const { variant = 'workspace' } = Astro.props
---

{
  variant === 'montage' ? (
    <figure
      class="experience-montage"
      aria-label="Illustrative customer journey: an answer from an approved guide, a service comparison and optional human support"
    >
      <div class="experience-montage__answer">
        <div class="preview-heading">
          <>
            <Leaf size={18} aria-hidden="true" />
            <strong>Oak &amp; Co AI</strong>
            <span>Illustrative workspace</span>
          </>
        </div>
        <div class="preview-conversation">
          <>
            <p class="preview-question">What are my delivery options?</p>
            <p class="preview-answer">
              I can explain the options using your approved delivery guide.
            </p>
          </>
        </div>
        <div class="preview-source">
          <>
            <FileText size={16} aria-hidden="true" />
            <span>Source: Delivery guide</span>
            <Check size={15} aria-hidden="true" />
          </>
        </div>
      </div>
      <ArrowRight
        class="experience-montage__arrow"
        size={20}
        aria-hidden="true"
      />
      <div class="experience-montage__compare">
        <div class="preview-heading">
          <>
            <GitCompareArrows size={18} aria-hidden="true" />
            <strong>Compare your options</strong>
          </>
        </div>
        <div class="preview-options">
          <>
            <div>
              <>
                <FileText size={25} aria-hidden="true" />
                <strong>Product guide</strong>
                <span>Explore the details</span>
              </>
            </div>
            <div>
              <>
                <MessageSquare size={25} aria-hidden="true" />
                <strong>Consultation</strong>
                <span>Discuss your needs</span>
              </>
            </div>
          </>
        </div>
        <p class="preview-caption">
          Your catalogue. Your approved information.
        </p>
      </div>
      <ArrowRight
        class="experience-montage__arrow"
        size={20}
        aria-hidden="true"
      />
      <div class="experience-montage__human">
        <div class="preview-heading">
          <>
            <Headphones size={17} aria-hidden="true" />
            <strong>Your team, when needed</strong>
          </>
        </div>
        <div class="preview-human-message">
          <>
            <img
              src="/assets/experiences/demo-support-agent.webp"
              alt="Fictional support agent"
              width="64"
              height="64"
            />
            <div>
              <>
                <strong>Continue with a person</strong>
                <p>Your team can help with the next step.</p>
              </>
            </div>
          </>
        </div>
        <span class="preview-optional">Optional with LoomAI Desk</span>
      </div>
    </figure>
  ) : variant === 'dealership' || variant === 'dealership-band' ? (
    <figure
      class:list={[
        'experience-preview',
        'experience-preview--dealership',
        { 'experience-preview--band': variant === 'dealership-band' },
      ]}
      aria-label="Fictional simulator inventory example: 2025 Aster E1, GBP 31,950"
    >
      <div class="preview-heading">
        <>
          <CarFront size={17} aria-hidden="true" />
          <strong>Northfield AI</strong>
          <span>Demo stock</span>
        </>
      </div>
      <img
        class="preview-vehicle"
        src="/assets/demos/dealership/vehicle-01.webp"
        alt="Blue vehicle used for the fictional Aster E1 demonstration"
        width="1400"
        height="2099"
        loading="lazy"
      />
      <div class="preview-vehicle-details">
        <>
          <strong>2025 Aster E1</strong>
          <span>Electric SUV</span>
          <b>GBP 31,950</b>
        </>
      </div>
      <div class="preview-vehicle-tools" aria-hidden="true">
        <>
          <span>
            <FileText size={14} />
            Live details
          </span>
          <span>
            <GitCompareArrows size={14} />
            Compare
          </span>
        </>
      </div>
    </figure>
  ) : (
    <figure
      class="experience-preview experience-preview--workspace"
      aria-label="Illustrative non-automotive workspace: Oak and Co AI compares information from an approved service guide"
    >
      <div class="preview-heading">
        <>
          <Leaf size={17} aria-hidden="true" />
          <strong>Oak &amp; Co AI</strong>
          <span>Example</span>
        </>
      </div>
      <div class="preview-workspace">
        <>
          <div class="preview-rail" aria-hidden="true">
            <>
              <MessageSquare size={18} />
              <Search size={18} />
              <GitCompareArrows size={18} />
              <Headphones size={18} />
            </>
          </div>
          <div class="preview-workspace__conversation">
            <>
              <p class="preview-question">Help me compare these options.</p>
              <p class="preview-answer">
                <Bot size={16} aria-hidden="true" />
                Let's look at your approved service guide.
              </p>
            </>
            <div class="preview-option-lines">
              <>
                <span>
                  <>
                    <FileText size={17} aria-hidden="true" />
                    <strong>Product details</strong>
                    <ChevronRight size={14} aria-hidden="true" />
                  </>
                </span>
                <span>
                  <>
                    <MessageSquare size={17} aria-hidden="true" />
                    <strong>Personal advice</strong>
                    <ChevronRight size={14} aria-hidden="true" />
                  </>
                </span>
              </>
            </div>
            <span class="preview-source">
              <FileText size={13} aria-hidden="true" />
              Service guide
            </span>
          </div>
        </>
      </div>
      <div class="preview-input" aria-hidden="true">
        <>
          <Paperclip size={15} />
          <span>Ask a question...</span>
          <Send size={15} />
        </>
      </div>
    </figure>
  )
}

<style>
  .experience-montage,
  .experience-preview {
    --preview-blue: #075ac9;
    --preview-mint: #007f79;
    --preview-amber: #86570d;
    --preview-panel: #fff;
    --preview-soft: #f6f9fd;
    --preview-question: #eaf2ff;
    color: var(--loom-text-primary);
    margin: 0;
    min-width: 0;
  }
  :global([data-theme='dark']) :is(.experience-montage, .experience-preview) {
    --preview-blue: #91b7ff;
    --preview-mint: #5fd8c8;
    --preview-amber: #f0c578;
    --preview-panel: #1d2329;
    --preview-soft: #252d35;
    --preview-question: #293c56;
  }
  .experience-montage {
    align-items: stretch;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1.25fr auto 1fr auto 1fr;
    padding-block: 0.5rem 1.5rem;
  }
  .experience-montage > div {
    background: var(--preview-panel);
    border-block: 1px solid var(--loom-border-default);
    min-width: 0;
    padding: 1rem;
  }
  .experience-montage__arrow {
    align-self: center;
    color: var(--preview-mint);
  }
  .preview-heading {
    align-items: center;
    display: flex;
    gap: 0.45rem;
    line-height: 1.3;
    min-width: 0;
  }
  .preview-heading > svg {
    color: var(--preview-mint);
    flex-shrink: 0;
  }
  .preview-heading strong {
    font-size: 0.8rem;
    font-weight: 700;
  }
  .preview-heading > span {
    color: var(--loom-text-muted);
    font-size: 0.65rem;
    margin-left: auto;
  }
  .preview-conversation {
    align-items: start;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: 0.9fr 1.1fr;
    padding-block: 0.9rem 0.75rem;
  }
  .preview-question,
  .preview-answer {
    border-radius: 6px;
    color: var(--loom-text-primary);
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0;
  }
  .preview-question {
    background: var(--preview-question);
    padding: 0.65rem 0.8rem;
  }
  .preview-answer {
    padding: 0.15rem 0;
  }
  .preview-source {
    align-items: center;
    color: var(--loom-text-secondary);
    display: flex;
    font-size: 0.7rem;
    gap: 0.45rem;
  }
  .preview-source > svg {
    color: var(--preview-blue);
    flex-shrink: 0;
  }
  .preview-source > svg:last-child:not(:first-child) {
    color: var(--preview-mint);
    margin-left: auto;
  }
  .preview-options {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-top: 0.8rem;
  }
  .preview-options > div {
    align-items: start;
    background: var(--preview-soft);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.65rem;
  }
  .preview-options svg {
    color: var(--preview-blue);
    margin-bottom: 0.2rem;
  }
  .preview-options strong {
    font-size: 0.72rem;
  }
  .preview-options span,
  .preview-caption {
    color: var(--loom-text-muted);
    font-size: 0.65rem;
    line-height: 1.4;
  }
  .preview-caption {
    margin: 0.65rem 0 0;
  }
  .experience-montage .experience-montage__human {
    background: var(--loom-warning-soft);
    border-color: transparent;
  }
  .experience-montage__human .preview-heading svg {
    color: var(--preview-amber);
  }
  .preview-human-message {
    align-items: center;
    display: flex;
    gap: 0.8rem;
    padding-block: 1.05rem 0.7rem;
  }
  .preview-human-message img {
    border-radius: 50%;
    flex: 0 0 3.75rem;
    height: 3.75rem;
    object-fit: cover;
    width: 3.75rem;
  }
  .preview-human-message strong {
    font-size: 0.8rem;
  }
  .preview-human-message p {
    font-size: 0.75rem;
    line-height: 1.45;
    margin: 0.3rem 0 0;
  }
  .preview-optional {
    color: var(--preview-amber);
    font-size: 0.65rem;
  }
  .experience-preview {
    background: var(--preview-panel);
    border: 1px solid var(--loom-border-default);
    border-radius: 6px;
    box-shadow: 0 8px 20px rgb(7 24 63 / 5%);
    overflow: hidden;
    width: 100%;
  }
  .experience-preview > .preview-heading {
    border-bottom: 1px solid var(--loom-border-subtle);
    padding: 0.65rem 0.75rem;
  }
  .preview-workspace {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
  }
  .preview-rail {
    align-items: center;
    background: var(--preview-soft);
    color: var(--preview-blue);
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    padding-block: 1rem;
  }
  .preview-workspace__conversation {
    display: grid;
    gap: 0.65rem;
    padding: 0.8rem;
  }
  .preview-workspace__conversation .preview-question {
    justify-self: end;
    max-width: 90%;
  }
  .preview-workspace__conversation .preview-answer {
    align-items: start;
    display: flex;
    gap: 0.35rem;
  }
  .preview-answer > svg {
    color: var(--preview-mint);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .preview-option-lines {
    display: grid;
    gap: 0.35rem;
  }
  .preview-option-lines > span {
    align-items: center;
    background: var(--preview-soft);
    display: flex;
    font-size: 0.7rem;
    gap: 0.45rem;
    padding: 0.55rem;
  }
  .preview-option-lines svg {
    color: var(--preview-blue);
    flex-shrink: 0;
  }
  .preview-option-lines svg:last-child {
    margin-left: auto;
  }
  .preview-input {
    align-items: center;
    border-top: 1px solid var(--loom-border-subtle);
    color: var(--loom-text-muted);
    display: flex;
    gap: 0.5rem;
    font-size: 0.7rem;
    padding: 0.65rem 0.75rem;
  }
  .preview-input > svg:last-child {
    color: var(--preview-blue);
    margin-left: auto;
  }
  .preview-vehicle {
    aspect-ratio: 2 / 1;
    height: auto;
    object-fit: cover;
    object-position: 50% 43%;
    width: 100%;
  }
  .preview-vehicle-details {
    display: grid;
    gap: 0.1rem 0.6rem;
    grid-template-columns: minmax(0, 1fr) auto;
    padding: 0.7rem 0.75rem;
  }
  .preview-vehicle-details strong {
    font-size: 0.85rem;
    grid-column: 1 / -1;
  }
  .preview-vehicle-details span {
    color: var(--loom-text-muted);
    font-size: 0.72rem;
  }
  .preview-vehicle-details b {
    font-size: 0.8rem;
  }
  .preview-vehicle-tools {
    border-top: 1px solid var(--loom-border-subtle);
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 0.6rem 0.75rem;
  }
  .preview-vehicle-tools span {
    align-items: center;
    background: var(--preview-question);
    border-radius: 4px;
    color: var(--preview-blue);
    display: flex;
    font-size: 0.7rem;
    gap: 0.35rem;
    justify-content: center;
    padding: 0.4rem;
  }
  .experience-preview--band {
    border-inline: 0;
    border-radius: 0;
    box-shadow: none;
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr);
  }
  .experience-preview--band > .preview-heading {
    grid-column: 1 / -1;
  }
  .experience-preview--band .preview-vehicle {
    grid-row: 2 / 4;
    height: 10rem;
  }
  .experience-preview--band .preview-vehicle-details {
    align-content: center;
    gap: 0.35rem 1rem;
    padding: 1rem 1.4rem;
  }
  .experience-preview--band .preview-vehicle-details strong {
    font-size: 1.1rem;
  }
  .experience-preview--band .preview-vehicle-details span,
  .experience-preview--band .preview-vehicle-details b {
    font-size: 0.9rem;
  }
  .experience-preview--band .preview-vehicle-tools {
    align-items: center;
    border: 0;
    justify-items: start;
    padding: 0 1.4rem 1rem;
  }
  .experience-preview--band .preview-vehicle-tools span {
    min-width: 8rem;
  }
  @media (max-width: 65rem) {
    .experience-montage {
      gap: 0.75rem;
      grid-template-columns: 1.2fr 1fr 1fr;
    }
    .experience-montage__arrow {
      display: none;
    }
    .preview-conversation {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
    .preview-human-message {
      align-items: start;
      flex-direction: column;
    }
  }
  @media (max-width: 42rem) {
    .experience-montage {
      gap: 1rem;
      grid-template-columns: 1fr;
      padding-bottom: 1rem;
    }
    .experience-montage > div {
      padding: 0.9rem 0;
    }
    .preview-conversation {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 0.9rem;
    }
    .experience-montage .experience-montage__compare {
      display: none;
    }
    .experience-montage .experience-montage__human {
      display: none;
    }
    .experience-preview--band {
      grid-template-columns: 1fr;
    }
    .experience-preview--band .preview-vehicle {
      grid-row: auto;
      height: auto;
    }
    .experience-preview--band .preview-vehicle-details {
      padding: 0.8rem;
    }
    .experience-preview--band .preview-vehicle-tools {
      padding: 0 0.8rem 0.8rem;
    }
  }
</style>
