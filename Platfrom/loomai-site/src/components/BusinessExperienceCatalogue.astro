---
import { ArrowLeftRight, ArrowRight, Box, CalendarDays, CarFront, CircleCheck, Eye, FileText, Headphones, MessageSquare, Monitor, CirclePlay, Search, ShoppingBag, Smartphone, Store, Ticket, AppWindow, SquareArrowOutUpRight } from '@lucide/astro'
import ExperienceCatalogueDialog from './ExperienceCatalogueDialog.astro'
import HomeKitScene from './HomeKitScene.astro'
import IntegrationCallAction from './IntegrationCallAction.astro'
import { homeKitCards, homeKitLaunchOffers, kitDetailUrl, kitOfferTerms } from './HomeKitCardsContent'
import '../styles/kit-cards.css'

const icons = {
  generic: [Search, ArrowLeftRight, ShoppingBag],
  dealership: [CarFront, ArrowLeftRight, CalendarDays],
  support: [FileText, Ticket, Headphones],
}
---

<experience-catalogue>
  <section class="business-experiences home-kits" id="experiences" aria-labelledby="experiences-title">
    <div class="loom-container">
      <header class="home-kits__heading"><h2 id="experiences-title">Choose your AI experience</h2><p>Start with a kit. Make it yours in LoomAI Console.</p></header>
      <div class="home-kits__grid">
        {homeKitCards.map(kit => {
          const Icon = kit.kind === 'dealership' ? CarFront : kit.kind === 'support' ? Headphones : Store
          const offer = homeKitLaunchOffers[kit.kind]
          return <div class="home-kit-option" data-kind={kit.kind}>
            <aside class="home-kit-offer" aria-label={offer.label}>
              <span><Icon size={22} />{kit.kind === 'dealership' ? offer.label : 'Launch offer'}</span><div><span>{offer.price}</span><strong>{offer.value}</strong></div>
              <ul>{offer.benefits.map(benefit => <li><CircleCheck size={17} />{benefit}</li>)}</ul>
            </aside>
            <article class={`business-kit home-kit experience-catalogue-theme experience-catalogue-theme--${kit.kind}`} aria-labelledby={`${kit.kind}-kit-title`}>
              <header class="home-kit__identity"><span><Icon size={20} />{kit.scope}</span><h3 id={`${kit.kind}-kit-title`}>{kit.title}</h3><p>{kit.summary}</p></header>
              <HomeKitScene kind={kit.kind} />
              <div class="home-kit__capabilities">{kit.features.map((feature, index) => { const FeatureIcon = icons[kit.kind][index]; return <span><FeatureIcon size={18} />{feature}</span> })}</div>
              <div class="home-kit__products"><div><span><Box size={25} />Platform</span><b>+</b><span><MessageSquare size={25} />Engage</span><b>+</b>
                <span><span class="home-kit__desk" aria-hidden="true"><span><img src="/assets/experiences/whatsapp.svg" alt="" width="11" height="11" /><Smartphone size={11} /></span><img src="/assets/experiences/demo-support-agent-headset.webp" alt="" width="32" height="32" loading="lazy" /></span>Human Desk</span></div><small>Human support optional with Desk</small></div>
              <a class="home-kit__explore" href={kitDetailUrl(kit.code)}>Explore kit in Console<ArrowRight size={19} aria-hidden="true" /></a>
              <div class="home-kit__commands"><button type="button" data-catalogue-preview={kit.kind} data-catalogue-initial-format="workspace" aria-haspopup="dialog" aria-controls={`catalogue-preview-${kit.kind}`}><Eye size={17} />{kit.preview}</button>
                {kit.kind === 'dealership' && <a href="/demos/dealership-ai"><CirclePlay size={17} />Try live demo</a>}</div>
            </article>
          </div>
        })}
      </div>
      <div class="home-kits__formats" aria-label="Ways to use your AI experience"><small>Choose one or combine them.</small><span><AppWindow size={24} />Website widget</span><span><Monitor size={24} />Max workspace</span><span><SquareArrowOutUpRight size={24} />Standalone app</span></div>
      <p class="home-kits__note">Illustrative previews. Configure your own branding, knowledge and integrations.</p>
      <p class="home-kits__offer-terms">{kitOfferTerms}</p>
      <div class="home-kits__team"><span>Prefer to start with our AI integration team?</span><IntegrationCallAction label="Start a project" /></div>
    </div>
  </section>
  {homeKitCards.map(kit => <ExperienceCatalogueDialog variant={kit.kind} />)}
</experience-catalogue>

<script>
  import type { CatalogueFormat } from './ExperienceCatalogueContent'
  class ExperienceCatalogue extends HTMLElement {
    private controller?: AbortController
    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      const { signal } = this.controller
      for (const trigger of this.querySelectorAll<HTMLButtonElement>('[data-catalogue-preview]')) {
        trigger.addEventListener('click', () => {
          const dialog = this.querySelector<HTMLDialogElement>(`#${trigger.getAttribute('aria-controls')}`)
          if (!dialog || dialog.open) return
          this.setFormat(dialog, trigger.dataset.catalogueInitialFormat as CatalogueFormat)
          dialog.showModal()
          dialog.scrollTop = 0
        }, { signal })
      }
      for (const dialog of this.querySelectorAll<HTMLDialogElement>('.catalogue-dialog')) {
        dialog.querySelector('[data-catalogue-close]')?.addEventListener('click', () => dialog.close(), { signal })
        let startedOnBackdrop = false
        const outside = (event: PointerEvent | MouseEvent) => {
          const rect = dialog.getBoundingClientRect()
          return event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom
        }
        dialog.addEventListener('pointerdown', event => { startedOnBackdrop = event.target === dialog && outside(event) }, { signal })
        dialog.addEventListener('click', event => {
          if (startedOnBackdrop && event.target === dialog && outside(event)) dialog.close()
          startedOnBackdrop = false
        }, { signal })
        for (const toggle of dialog.querySelectorAll<HTMLButtonElement>('[data-catalogue-format]')) toggle.addEventListener('click', () => this.setFormat(dialog, toggle.dataset.catalogueFormat as CatalogueFormat), { signal })
      }
    }
    disconnectedCallback() { this.controller?.abort() }
    private setFormat(dialog: HTMLDialogElement, format: CatalogueFormat) {
      dialog.dataset.format = format
      for (const toggle of dialog.querySelectorAll<HTMLButtonElement>('[data-catalogue-format]')) toggle.setAttribute('aria-pressed', String(toggle.dataset.catalogueFormat === format))
      const address = dialog.querySelector<HTMLElement>('[data-catalogue-address]')
      if (address) address.textContent = format === 'website' ? address.dataset.websiteAddress ?? '' : address.dataset.standaloneAddress ?? ''
    }
  }
  if (!customElements.get('experience-catalogue')) customElements.define('experience-catalogue', ExperienceCatalogue)
</script>
