---
import { ArrowRight } from '@lucide/astro'
---

<a class="developer-entry" href="https://developer.loomai.pro/">
  <img class="developer-entry__brain" src="/assets/developer/smart-brain.png" width="34" height="34" alt="" decoding="async" />
  <span class="developer-entry__copy">
    <strong>Developer?</strong>
    <small>Configure your Smart Brain</small>
  </span>
  <ArrowRight class="developer-entry__arrow" size={17} aria-hidden="true" />
</a>

<style>
  .developer-entry {
    align-items: center;
    background: #edf9f6;
    border: 1px solid #5cb9ad;
    border-radius: 8px;
    color: var(--loom-text-primary);
    display: inline-flex;
    gap: 8px;
    max-width: 100%;
    min-height: 48px;
    padding: 7px 10px;
    text-decoration: none;
    transition: background 160ms, border-color 160ms;
  }
  .developer-entry__copy { display: grid; gap: 2px; min-width: 0; }
  .developer-entry__copy strong { font-size: 13px; line-height: 1.3; }
  .developer-entry__copy small { color: var(--loom-text-muted); font-size: 10px; line-height: 1.3; }
  .developer-entry__brain { flex: 0 0 34px; height: 34px; object-fit: contain; width: 34px; }
  .developer-entry__arrow { flex-shrink: 0; margin-left: auto; }
  .developer-entry:hover { background: #e1f4ef; border-color: #147d70; text-decoration: none; }
  .developer-entry:focus-visible { outline: 2px solid #087c70; outline-offset: 4px; }
  :global(:root[data-theme='dark']) .developer-entry { background: #132d2b; border-color: #428b80; }
  :global(:root[data-theme='dark']) .developer-entry:hover { background: #193b36; border-color: #64dfcd; }
  :global(:root[data-theme='dark']) .developer-entry:focus-visible { outline-color: #64dfcd; }
  @media (max-width: 42rem) {
    .developer-entry__brain { flex-basis: 28px; height: 28px; width: 28px; }
    .developer-entry__arrow { display: none; }
  }
</style>
