---
import { ArrowRight } from '@lucide/astro'

type Props = {
  steps: string[]
  label?: string
}

const { steps, label = 'Architecture flow' } = Astro.props
---

<ol class="architecture-flow" aria-label={label}>
  {steps.map((step, index) => (
    <li>
      <span class="architecture-flow__number">{String(index + 1).padStart(2, '0')}</span>
      <strong>{step}</strong>
      {index < steps.length - 1 && (
        <ArrowRight class="architecture-flow__arrow" size={20} stroke-width={1.6} aria-hidden="true" />
      )}
    </li>
  ))}
</ol>
