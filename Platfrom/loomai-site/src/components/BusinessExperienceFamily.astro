---
import {
  ArrowRight,
  Box,
  CodeXml,
  Headphones,
  Layers,
  MessageSquare,
} from '@lucide/astro'
---

<section
  class="business-family"
  id="product-family"
  aria-labelledby="product-family-title"
>
  <div class="loom-container">
    <h2 id="product-family-title">Powered by the LoomAI product family</h2>
    <div class="business-family__products">
      <a href="/products/loomai-platform"
        ><Box size={39} stroke-width={1.6} aria-hidden="true" /><span
          ><strong>Platform</strong><small>Connect and run your AI</small></span
        ><ArrowRight size={17} aria-hidden="true" /></a
      >
      <a href="https://console.loomai.pro/products/engage"
        ><MessageSquare size={39} stroke-width={1.6} aria-hidden="true" /><span
          ><strong>Engage</strong><small>Website widget or standalone app</small
          ></span
        ><ArrowRight size={17} aria-hidden="true" /></a
      >
      <a href="https://console.loomai.pro/products/desk"
        ><Headphones size={39} stroke-width={1.6} aria-hidden="true" /><span
          ><strong>Desk <em>Optional</em></strong><small
            >Your team inside the conversation</small
          ></span
        ><ArrowRight size={17} aria-hidden="true" /></a
      >
    </div>
    <div class="business-family__foundations">
      <p>Open-source foundations</p><div>
        <a href="/products/ai-fabric-framework"
          ><CodeXml size={27} stroke-width={1.6} aria-hidden="true" />AI Fabric
          Framework<ArrowRight size={15} aria-hidden="true" /></a
        ><a href="/products/ai-fabric-chat-ui"
          ><Layers size={27} stroke-width={1.6} aria-hidden="true" />AI Fabric
          Chat UI<ArrowRight size={15} aria-hidden="true" /></a
        >
      </div>
    </div>
    <div class="business-family__help">
      <p>Need help connecting your systems?</p><a
        href="https://console.loomai.pro/support"
        >Request integration help<ArrowRight size={16} aria-hidden="true" /></a
      >
    </div>
    <div class="business-family__more">
      <a href="/products"
        >All products<ArrowRight size={14} aria-hidden="true" /></a
      ><a href="/experiments"
        >Live demos<ArrowRight size={14} aria-hidden="true" /></a
      ><a href="/research"
        >Applied research<ArrowRight size={14} aria-hidden="true" /></a
      >
    </div>
  </div>
</section>
<style>
  .business-family {
    padding-block: 1.7rem 2rem;
  }
  h2 {
    font-size: 1.9rem;
    margin-bottom: 1.4rem;
  }
  .business-family__products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 1.7rem;
  }
  .business-family__products > a {
    align-items: center;
    border-right: 1px solid var(--loom-border-default);
    display: flex;
    gap: 1.2rem;
    min-width: 0;
    padding-inline: 1.6rem;
    text-decoration: none;
  }
  .business-family__products > a:first-child {
    padding-left: 0;
  }
  .business-family__products > a:last-child {
    border: 0;
    padding-right: 0;
  }
  .business-family__products > a > svg:first-child {
    color: var(--loom-blue-600);
    flex-shrink: 0;
  }
  .business-family__products > a:nth-child(2) > svg:first-child {
    color: #009d92;
  }
  .business-family__products > a:nth-child(3) > svg:first-child {
    color: #ba7708;
  }
  .business-family__products > a > svg:last-child {
    color: var(--loom-text-muted);
    flex-shrink: 0;
    margin-left: auto;
  }
  strong,
  small {
    display: block;
  }
  strong {
    font-size: 1.1rem;
    line-height: 1.5;
  }
  strong em {
    background: var(--loom-warning-soft);
    border-radius: 4px;
    color: #86570d;
    display: inline-block;
    font-size: 0.65rem;
    font-style: normal;
    font-weight: 600;
    margin-left: 0.3rem;
    padding: 0.1rem 0.4rem;
    vertical-align: middle;
  }
  :global([data-theme='dark']) strong em {
    color: #f0c578;
  }
  small {
    color: var(--loom-text-secondary);
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .business-family__foundations {
    border-top: 1px solid var(--loom-border-default);
    padding-top: 0.9rem;
    text-align: center;
  }
  .business-family__foundations p {
    color: var(--loom-text-muted);
    font-size: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .business-family__foundations > div {
    display: flex;
    gap: 2rem;
    justify-content: center;
  }
  .business-family__foundations a {
    align-items: center;
    color: var(--loom-text-secondary);
    display: inline-flex;
    font-size: 0.9rem;
    gap: 0.6rem;
    text-decoration: none;
  }
  .business-family__foundations a + a {
    border-left: 1px solid var(--loom-border-default);
    padding-left: 2rem;
  }
  .business-family__help {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: center;
    margin-top: 1.4rem;
  }
  .business-family__help p {
    font-size: 0.8rem;
    margin: 0;
  }
  .business-family__help a,
  .business-family__more a {
    align-items: center;
    color: var(--loom-blue-600);
    display: inline-flex;
    font-size: 0.8rem;
    gap: 0.4rem;
    text-decoration: none;
  }
  .business-family__more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.5rem;
    justify-content: center;
    margin-top: 1.3rem;
  }
  .business-family__more a {
    color: var(--loom-text-muted);
    font-size: 0.72rem;
  }
  a:hover strong,
  .business-family__foundations a:hover,
  .business-family__help a:hover {
    color: var(--loom-blue-600);
  }
  :global([data-theme='dark'])
    .business-family__products
    > a:nth-child(2)
    > svg:first-child {
    color: #59dbcb;
  }
  :global([data-theme='dark'])
    .business-family__products
    > a:nth-child(3)
    > svg:first-child {
    color: #f0c578;
  }
  @media (max-width: 55rem) {
    .business-family__products {
      gap: 1.2rem;
      grid-template-columns: 1fr;
    }
    .business-family__products > a {
      border: 0;
      border-bottom: 1px solid var(--loom-border-subtle);
      padding: 0 0 1.1rem;
    }
    .business-family__products > a:last-child {
      padding-bottom: 0;
    }
  }
  @media (max-width: 42rem) {
    h2 {
      font-size: 1.6rem;
    }
    .business-family__foundations > div {
      align-items: center;
      flex-direction: column;
      gap: 0.9rem;
    }
    .business-family__foundations a + a {
      border: 0;
      padding: 0;
    }
    .business-family__help {
      align-items: center;
      flex-direction: column;
    }
  }
</style>
