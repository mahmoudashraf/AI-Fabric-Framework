---
import { ArrowRight, ExternalLink } from '@lucide/astro'
import type { Experiment } from '../data/types'

type Props = {
  experiment: Experiment
  featured?: boolean
}

const { experiment, featured = false } = Astro.props
---

<article
  class:list={['experiment-card loom-card', { 'experiment-card--featured': featured }]}
  data-interactive="true"
  data-filter-item
  data-category={experiment.primaryCategory}
>
  <a class="experiment-card__media" href={`/experiments/${experiment.slug}`} tabindex="-1" aria-hidden="true">
    <img
      src={experiment.screenshot.src}
      alt=""
      width="1280"
      height="800"
      loading={featured ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <div class="experiment-card__body">
    <div class="card-meta">
      <span class="status-dot status-dot--live">{experiment.status}</span>
      <span>{experiment.categoryLabel}</span>
    </div>
    <h3><a href={`/experiments/${experiment.slug}`}>{experiment.title}</a></h3>
    <p>{experiment.scenario}</p>
    <ul class="tag-list" aria-label={`${experiment.title} capabilities`}>
      {experiment.capabilityTags.slice(0, 4).map((tag) => <li>{tag}</li>)}
    </ul>
    <p class="experiment-card__proof">{experiment.observableProof[0]}</p>
    <div class="experiment-card__actions">
      <a class="text-link" href={`/experiments/${experiment.slug}`}>
        About
        <ArrowRight size={16} aria-hidden="true" />
      </a>
      <a
        class="text-link"
        href={experiment.links.launch.href}
        target="_blank"
        rel="noreferrer"
      >
        Launch
        <ExternalLink size={15} aria-hidden="true" />
      </a>
    </div>
  </div>
</article>
