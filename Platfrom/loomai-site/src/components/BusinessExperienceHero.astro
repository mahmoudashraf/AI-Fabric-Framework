---
import { ArrowRight } from '@lucide/astro'
import IntegrationCallAction from './IntegrationCallAction.astro'
import DeveloperEntryCard from './DeveloperEntryCard.astro'
---

<section class="business-hero" aria-labelledby="business-title">
  <div class="loom-container">
    <div class="business-hero__eyebrow">
      <p class="loom-eyebrow">LoomAI for business</p><a
        class="business-console"
        href="https://console.loomai.pro/"
        >Get started<ArrowRight size={16} aria-hidden="true" /></a
      >
    </div>
    <h1 id="business-title">AI Customer Experience</h1>
    <div class="business-hero__intro">
      <div>
        <p>
          Help customers find answers, choose confidently and take the next step.
        </p><p>Your business information. Your brand. Your team when they need a person.</p>
      </div>
    </div>
    <div class="business-hero__actions">
      <IntegrationCallAction class="business-hero__contact" />
      <DeveloperEntryCard />
    </div>
  </div>
</section>
<style>
  .business-hero {
    border-bottom: 1px solid var(--loom-border-subtle);
    padding-block: 1.6rem 0.3rem;
  }
  .business-hero__eyebrow {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 0.8rem;
  }
  .business-hero__eyebrow .loom-eyebrow {
    margin: 0;
  }
  .business-console {
    align-items: center;
    color: var(--loom-blue-600);
    display: inline-flex;
    font-size: 0.85rem;
    font-weight: 650;
    gap: 0.4rem;
    text-decoration: none;
  }
  h1 {
    font-size: 3rem;
    margin-bottom: 0.75rem;
  }
  .business-hero__intro {
    align-items: center;
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
    margin-bottom: 1.2rem;
  }
  .business-hero__intro p {
    font-size: 1rem;
    line-height: 1.55;
    margin-bottom: 0.2rem;
  }
  .business-hero__intro p:last-child {
    color: var(--loom-text-muted);
    font-size: 0.9rem;
    margin: 0;
  }
  .business-hero__actions {
    align-items: stretch;
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.1rem;
  }
  @media (max-width: 42rem) {
    .business-hero {
      padding-top: 1.3rem;
    }
    h1 {
      font-size: 2.25rem;
      line-height: 1.13;
    }
    .business-hero__intro p {
      font-size: 0.95rem;
    }
    .business-hero__actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .business-hero__actions :global(.business-hero__contact svg) { display: none; }
  }
</style>
