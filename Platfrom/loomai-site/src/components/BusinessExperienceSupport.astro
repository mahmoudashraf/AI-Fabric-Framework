---
import { ArrowRight, Headphones } from '@lucide/astro'
---

<aside class="business-support" aria-labelledby="business-support-title">
  <img
    src="/assets/experiences/demo-support-agent.webp"
    alt="Fictional support agent"
    width="64"
    height="64"
    loading="lazy"
  />
  <Headphones size={36} stroke-width={1.6} aria-hidden="true" />
  <div>
    <h2 id="business-support-title">Human support, when you need it</h2><p>
      Add LoomAI Desk to either experience. Your agents keep the conversation
      and its context.
    </p>
  </div>
  <a href="https://console.loomai.pro/products/desk"
    ><span>Optional</span><span class="visually-hidden"
      >: Explore LoomAI Desk</span
    ><ArrowRight size={16} aria-hidden="true" /></a
  >
</aside>
<style>
  .business-support {
    align-items: center;
    background: var(--loom-warning-soft);
    display: flex;
    gap: 1.2rem;
    padding: 1rem 1.4rem;
  }
  img {
    border-radius: 50%;
    flex: 0 0 3.75rem;
    height: 3.75rem;
    object-fit: cover;
    width: 3.75rem;
  }
  .business-support > svg {
    color: #ba7708;
    flex-shrink: 0;
  }
  h2 {
    font-size: 1.15rem;
    margin: 0 0 0.3rem;
  }
  p {
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0;
  }
  a {
    align-items: center;
    color: #86570d;
    display: flex;
    font-size: 0.8rem;
    font-weight: 650;
    gap: 0.5rem;
    margin-left: auto;
    text-decoration: none;
  }
  :global([data-theme='dark']) a {
    color: #f0c578;
  }
  :global([data-theme='dark']) .business-support > svg {
    color: #f0c578;
  }
  @media (max-width: 42rem) {
    .business-support {
      align-items: start;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding: 1rem;
    }
    img {
      flex-basis: 2.75rem;
      height: 2.75rem;
      width: 2.75rem;
    }
    .business-support > svg {
      display: none;
    }
    .business-support > div {
      flex: 1;
      min-width: 12rem;
    }
    h2 {
      font-size: 1rem;
    }
    p {
      font-size: 0.8rem;
    }
    a {
      margin-left: 3.5rem;
    }
  }
</style>
