---
import { ArrowRight, FlaskConical } from '@lucide/astro'
import PlatformSystemVisual from './PlatformSystemVisual.astro'

type Props = {
  heading?: string
  headingId?: string
}

const {
  heading = 'Products from the lab',
  headingId = 'products-from-lab',
} = Astro.props
---

<div class="lab-products">
  <h2 id={headingId}>{heading}</h2>

  <article class="lab-platform-card">
    <div class="lab-platform-card__copy">
      <p class="lab-product-card__eyebrow">Managed product layer</p>
      <span class="lab-platform-card__status">Managed preview</span>
      <h3>LoomAI Platform</h3>
      <p>
        Compose templates, plugins and provider profiles into verified,
        self-contained AI deployments built on AI Fabric Framework and Chat UI.
      </p>
      <ul aria-label="Platform capabilities">
        <li>Marketplace composition</li>
        <li>Deployment lifecycle</li>
        <li>Release verification</li>
      </ul>
      <div class="lab-platform-card__actions">
        <a class="loom-button loom-button--primary" href="/products/loomai-platform">
          Explore Platform
        </a>
        <a class="lab-platform-card__demo" href="/demos/dealership-ai">
          <FlaskConical size={17} stroke-width={1.7} aria-hidden="true" />
          Dealership live demo
          <ArrowRight size={16} aria-hidden="true" />
        </a>
      </div>
    </div>

    <PlatformSystemVisual compact />
  </article>

  <div class="lab-product-rail" aria-label="LoomAI Platform is built on the two open-source product foundations">
    <span>Built on two open-source foundations</span>
  </div>

  <div class="lab-product-grid">
    <article class="lab-product-card">
      <p class="lab-product-card__eyebrow">Application enablement layer</p>
      <img
        class="lab-product-card__mark"
        src="/assets/reference/framework-mark.png"
        alt="AI Fabric Framework mark"
        width="135"
        height="175"
        loading="lazy"
      />
      <div class="lab-product-card__copy">
        <h3>AI Fabric Framework</h3>
        <p>
          Live application data, evidence-grounded retrieval and governed
          actions for Java and Spring Boot.
        </p>
        <ul aria-label="Framework capabilities">
          <li>Live data sync</li>
          <li>Governed RAG</li>
          <li>Controlled actions</li>
        </ul>
        <a class="loom-button loom-button--primary" href="/products/ai-fabric-framework">
          Explore framework
        </a>
      </div>
      <img
        class="lab-product-card__art"
        src="/assets/reference/framework-stack.png"
        alt=""
        width="215"
        height="270"
        loading="lazy"
      />
    </article>

    <article class="lab-product-card lab-product-card--chat">
      <p class="lab-product-card__eyebrow">User experience layer</p>
      <div class="lab-product-card__copy">
        <h3>AI Fabric Chat UI</h3>
        <p>
          A reusable, framework-neutral chat interface for AI Fabric-enabled
          applications.
        </p>
        <ul aria-label="Chat UI capabilities">
          <li>Web Component</li>
          <li>React</li>
          <li>Arabic and RTL</li>
          <li>Four layouts</li>
        </ul>
        <a class="loom-button loom-button--primary" href="/products/ai-fabric-chat-ui">
          Explore Chat UI
        </a>
      </div>
      <img
        class="lab-product-card__preview"
        src="/assets/reference/chat-card-preview.png"
        alt="AI Fabric Chat UI showing evidence and a confirmed action"
        width="325"
        height="270"
        loading="lazy"
      />
    </article>
  </div>

</div>

<style>
  .lab-products h2 {
    font-size: 1.45rem;
    margin-bottom: 0.7rem;
  }

  .lab-product-grid {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .lab-platform-card {
    align-items: center;
    background: #fff;
    border: 1px solid var(--loom-border-strong);
    border-radius: 0.5rem;
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    grid-template-columns: minmax(18rem, 0.82fr) minmax(34rem, 1.3fr);
    min-height: 23rem;
    overflow: hidden;
    padding: 2.3rem;
    position: relative;
  }

  .lab-platform-card::before {
    background: var(--loom-gradient-brand);
    content: "";
    height: 4px;
    inset: 0 0 auto;
    position: absolute;
  }

  .lab-platform-card__copy {
    min-width: 0;
  }

  .lab-platform-card .lab-product-card__eyebrow {
    inset: auto;
    margin-bottom: 0.8rem;
    position: static;
  }

  .lab-platform-card__status {
    align-items: center;
    color: var(--loom-success);
    display: inline-flex;
    font-size: 0.68rem;
    font-weight: 750;
    gap: 0.35rem;
    margin-bottom: 0.65rem;
    text-transform: uppercase;
  }

  .lab-platform-card__status::before {
    background: #13ad72;
    border-radius: 50%;
    content: "";
    height: 0.45rem;
    width: 0.45rem;
  }

  .lab-platform-card h3 {
    font-size: 3rem;
    margin-bottom: 0.7rem;
  }

  .lab-platform-card__copy > p:not(.lab-product-card__eyebrow) {
    font-size: 1rem;
    line-height: 1.55;
    margin-bottom: 0.9rem;
    max-width: 38rem;
  }

  .lab-platform-card ul {
    color: var(--loom-blue-600);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.72rem;
    gap: 0.3rem 0;
    list-style: none;
    margin: 0 0 1.3rem;
    padding: 0;
  }

  .lab-platform-card li + li::before {
    color: var(--loom-navy-500);
    content: "·";
    margin-inline: 0.45rem;
  }

  .lab-platform-card__actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.2rem;
  }

  .lab-platform-card__demo {
    align-items: center;
    color: var(--loom-blue-600);
    display: inline-flex;
    font-size: 0.78rem;
    font-weight: 700;
    gap: 0.4rem;
    min-height: 2.7rem;
    text-decoration: none;
  }

  .lab-product-card {
    background: linear-gradient(145deg, #fff 55%, #f7f9ff);
    border: 1px solid var(--loom-border-strong);
    border-radius: 0.75rem;
    display: grid;
    grid-template-columns: 7.75rem minmax(0, 1fr) 13.25rem;
    min-height: 18.2rem;
    overflow: hidden;
    padding: 3.5rem 1.25rem 1.15rem;
    position: relative;
  }

  .lab-product-card__eyebrow {
    color: var(--loom-blue-vivid);
    font-size: 0.7rem;
    font-weight: 700;
    inset: 1.15rem auto auto 1.9rem;
    letter-spacing: 0.12em;
    position: absolute;
    text-transform: uppercase;
  }

  .lab-product-card__mark {
    align-self: center;
    height: 10.9rem;
    object-fit: contain;
    width: 7.4rem;
  }

  .lab-product-card__copy {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0.3rem 0.25rem 0;
    position: relative;
    z-index: 2;
  }

  .lab-product-card h3 {
    font-size: 2rem;
    margin-bottom: 0.55rem;
    white-space: nowrap;
  }

  .lab-product-card__copy > p {
    font-size: 0.96rem;
    line-height: 1.4;
    margin-bottom: 0.55rem;
    max-width: 28ch;
  }

  .lab-product-card ul {
    color: var(--loom-blue-vivid);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.68rem;
    gap: 0.35rem 0;
    list-style: none;
    margin: 0 0 0.9rem;
    padding: 0;
  }

  .lab-product-card li + li::before {
    color: var(--loom-navy-500);
    content: "·";
    margin-inline: 0.4rem;
  }

  .lab-product-card .loom-button {
    align-self: start;
    margin-top: auto;
    min-height: 2.7rem;
    min-width: 11.25rem;
    padding-inline: 1rem;
  }

  .lab-product-card__art {
    align-self: center;
    height: auto;
    justify-self: end;
    max-width: none;
    width: 11.2rem;
  }

  .lab-product-card--chat {
    grid-template-columns: minmax(0, 1fr) 18.25rem;
    padding-left: 1.95rem;
  }

  .lab-product-card--chat .lab-product-card__copy {
    padding-right: 0.5rem;
  }

  .lab-product-card--chat .lab-product-card__copy > p {
    max-width: 31ch;
  }

  .lab-product-card__preview {
    align-self: center;
    border-radius: 0.65rem;
    box-shadow: 0 7px 20px rgb(10 29 74 / 8%);
    height: auto;
    justify-self: end;
    max-width: none;
    width: 16.5rem;
  }

  .lab-product-rail {
    height: 4.1rem;
    margin-inline: auto;
    position: relative;
    width: 61%;
  }

  .lab-product-rail::before {
    border: 1px solid var(--loom-indigo-500);
    border-bottom: 0;
    border-radius: 0.7rem 0.7rem 0 0;
    content: "";
    height: 1.45rem;
    inset: auto 0 0;
    position: absolute;
  }

  .lab-product-rail::after {
    background: var(--loom-indigo-500);
    content: "";
    height: 1.25rem;
    left: 50%;
    position: absolute;
    top: 0;
    width: 1px;
  }

  .lab-product-rail span {
    background: var(--loom-canvas);
    border: 1px solid var(--loom-border-accent);
    border-radius: 999px;
    color: var(--loom-blue-600);
    font-size: 0.78rem;
    left: 50%;
    min-width: 15.5rem;
    padding: 0.25rem 1rem;
    position: absolute;
    text-align: center;
    top: 0.72rem;
    transform: translateX(-50%);
    z-index: 1;
  }

  @media (max-width: 75rem) {
    .lab-platform-card {
      gap: 2rem;
      grid-template-columns: minmax(17rem, 0.78fr) minmax(30rem, 1.22fr);
      padding: 2rem;
    }

    .lab-product-card {
      grid-template-columns: 6rem minmax(0, 1fr) 9rem;
    }

    .lab-product-card__mark {
      width: 5.75rem;
    }

    .lab-product-card__art {
      width: 10.5rem;
    }

    .lab-product-card h3 {
      font-size: 1.6rem;
    }

    .lab-product-card--chat {
      grid-template-columns: minmax(0, 1fr) 13rem;
    }

    .lab-product-card__preview {
      width: 13rem;
    }
  }

  @media (max-width: 63.99rem) {
    .lab-platform-card {
      grid-template-columns: 1fr;
    }

    .lab-product-grid {
      grid-template-columns: 1fr;
    }

    .lab-product-card,
    .lab-product-card--chat {
      grid-template-columns: 7.5rem minmax(0, 1fr) 14rem;
    }

    .lab-product-card--chat .lab-product-card__copy {
      grid-column: 1 / 3;
    }

    .lab-product-card__preview {
      grid-column: 3;
      width: 14rem;
    }
  }

  @media (max-width: 47.99rem) {
    .lab-platform-card {
      min-height: 0;
      padding: 1.55rem 1.15rem 1.25rem;
    }

    .lab-platform-card h3 {
      font-size: 2rem;
    }

    .lab-platform-card__actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .lab-product-card,
    .lab-product-card--chat {
      display: flex;
      flex-direction: column;
      padding: 3.7rem 1.25rem 1.25rem;
    }

    .lab-product-card__mark {
      align-self: flex-start;
      height: 7rem;
      margin-bottom: 0.75rem;
      width: 5.5rem;
    }

    .lab-product-card h3 {
      font-size: 1.75rem;
      white-space: normal;
    }

    .lab-product-card__art,
    .lab-product-card__preview {
      align-self: center;
      margin-top: 1.25rem;
      width: min(100%, 18rem);
    }

    .lab-product-card__art {
      order: 3;
    }

    .lab-product-rail {
      width: 84%;
    }
  }
</style>
