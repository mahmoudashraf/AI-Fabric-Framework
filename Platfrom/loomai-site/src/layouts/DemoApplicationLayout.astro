---
import '@fontsource-variable/inter'
import '@fontsource-variable/jetbrains-mono'
import '../styles/global.css'
import { site } from '../data/content'

type Props = {
  title: string
  description: string
  canonicalPath?: string
  noIndex?: boolean
  skipLabel?: string
  installAIWorkspace?: boolean
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noIndex = false,
  skipLabel = 'Skip to inventory',
  installAIWorkspace = false,
} = Astro.props

const aiWorkspaceInstallUrl = import.meta.env.DEV
  ? (import.meta.env.PUBLIC_AI_WORKSPACE_INSTALL_URL || 'http://127.0.0.1:8080/api/public/ai-workspace/install.js')
  : '__LOOMAI_AI_WORKSPACE_INSTALL_URL__'
const aiWorkspaceInstallationId = import.meta.env.DEV
  ? (import.meta.env.PUBLIC_AI_WORKSPACE_INSTALLATION_ID || 'awi_pub_00000000000000000000000000000000')
  : '__LOOMAI_AI_WORKSPACE_INSTALLATION_ID__'

const pageTitle = `${title} | ${site.name}`
const canonicalUrl = new URL(canonicalPath, site.canonicalOrigin).toString()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#123b35" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body class="demo-application-body">
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <main id="main-content">
      <slot />
    </main>
    {installAIWorkspace && (
      <script
        is:inline
        async
        src={aiWorkspaceInstallUrl}
        data-installation-id={aiWorkspaceInstallationId}
        data-loomai-ai-workspace="true"
      ></script>
    )}
  </body>
</html>

<style is:global>
  body.demo-application-body {
    background: #f5f7f4;
    min-width: 20rem;
  }

  body.demo-application-body main {
    min-height: 100vh;
  }
</style>
